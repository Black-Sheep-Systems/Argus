def run(cmd, timeout=20):
    """Run a fixed command; return stdout, or None if it failed."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


def unit_active(unit):
    """True while a unit is running or starting (read whatever the exit code)."""
    try:
        p = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return p.stdout.strip() in ("active", "activating", "reloading")


def dpkg_busy():
    """True if apt or dpkg holds its lock (both use fcntl locks)."""
    try:
        fd = os.open("/var/lib/dpkg/lock-frontend", os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.lockf(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def busy_reason():
    for job in JOBS:
        if unit_active("argus-" + job + ".service"):
            return "the " + job + " job is still running"
    if dpkg_busy():
        return "the server is installing updates right now"
    return None


def safe(fn):
    """Anything that can't be read is reported as null ("unknown" in Argus)."""
    try:
        return fn()
    except Exception:
        return None


def server():
    with open("/proc/uptime") as f:
        up = int(float(f.read().split()[0]))
    load = os.getloadavg()[0]
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mem[k] = int(v.split()[0]) * 1024
    du = shutil.disk_usage("/")
    return {
        "uptime_s": up,
        "load_1m": round(load, 2),
        "cpus": os.cpu_count(),
        "mem_used_b": mem["MemTotal"] - mem["MemAvailable"],
        "mem_total_b": mem["MemTotal"],
        "disk_used_b": du.used,
        "disk_total_b": du.total,
        "reboot_needed": os.path.exists("/run/reboot-required"),
        "reboot_scheduled": os.path.exists("/run/systemd/shutdown/scheduled"),
    }


def services():
    out = run(["docker", "ps", "-a", "--format", "{{.Names}}\t{{.State}}\t{{.Status}}"])
    if out is None:
        return None
    running, stopped, unhealthy, finished, names = 0, [], [], [], []
    for line in out.splitlines():
        name, state, status = line.split("\t")
        if state == "running":
            running += 1
            names.append(name)
            if "(unhealthy)" in status:
                unhealthy.append(name)
        elif name in ONE_SHOT and "Exited (0)" in status:
            finished.append(name)
        else:
            stopped.append(name)
    return {"running": running, "unhealthy": unhealthy, "stopped": stopped, "finished_one_shot": finished,
            "names": sorted(names)}


def site_names():
    names = []
    with open(CADDYFILE) as f:
        for line in f:
            m = re.match(r"^([a-z0-9.,: -]+)\{\s*$", line)
            if m:
                names += [n for n in re.split(r"[,\s]+", m.group(1)) if n]
    return [n for n in names if re.fullmatch(r"[a-z0-9.-]+", n)]


def cert_days(name):
    try:
        p1 = subprocess.run(
            ["openssl", "s_client", "-connect", "127.0.0.1:443", "-servername", name],
            input="", capture_output=True, text=True, timeout=6)
        p2 = subprocess.run(["openssl", "x509", "-noout", "-enddate"],
                            input=p1.stdout, capture_output=True, text=True, timeout=5)
        end = p2.stdout.strip().split("=", 1)[1]
        exp = datetime.datetime.strptime(end, "%b %d %H:%M:%S %Y GMT").replace(tzinfo=datetime.timezone.utc)
        return (exp - datetime.datetime.now(datetime.timezone.utc)).days
    except Exception:
        return None


def websites():
    names = site_names()
    with ThreadPoolExecutor(max_workers=32) as ex:
        days = list(ex.map(cert_days, names))
    return [{"name": n, "cert_days": d} for n, d in zip(names, days)]


def jobs():
    units = []
    for n in TIMERS:
        units += [n + ".service", n + ".timer"]
    out = run(["systemctl", "show", "-p", "Id,LoadState,Result,ExecMainExitTimestamp,NextElapseUSecRealtime", *units])
    if out is None:
        return None
    blocks = {}
    for block in out.strip().split("\n\n"):
        d = dict(l.split("=", 1) for l in block.splitlines() if "=" in l)
        blocks[d.get("Id")] = d
    res = []
    for n in TIMERS:
        svc, tmr = blocks.get(n + ".service", {}), blocks.get(n + ".timer", {})
        if svc.get("LoadState") != "loaded" or tmr.get("LoadState") != "loaded":
            res.append({"name": n, "result": "missing", "last_run": None, "next_run": None})
            continue
        res.append({"name": n, "result": svc.get("Result") or None,
                    "last_run": svc.get("ExecMainExitTimestamp") or None,
                    "next_run": tmr.get("NextElapseUSecRealtime") or None})
    return res


def backups():
    res = {}
    for k, path in BACKUP_DIRS.items():
        try:
            entries = [os.path.join(path, e) for e in os.listdir(path) if not e.endswith(".part")]
            newest = max(entries, key=os.path.getmtime) if entries else None
            res[k] = {"count": len(entries),
                      "newest_age_h": round((time.time() - os.path.getmtime(newest)) / 3600, 1) if newest else None}
        except OSError:
            res[k] = None
    res["overwrites_b"] = dir_size(OVERWRITE_BACKUPS) if os.path.isdir(OVERWRITE_BACKUPS) else 0
    return res


def updates():
    out = run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "upgrade"], timeout=25)
    if out is None:
        return None
    lines = [l for l in out.splitlines() if l.startswith("Inst ")]
    return {"waiting": len(lines), "security": sum(1 for l in lines if "security" in l.lower())}


def signins():
    out = run(["journalctl", "-u", "ssh", "--since", "-24h", "-o", "cat", "--no-pager"], timeout=30)
    if out is None:
        return None
    accepted = sum(1 for l in out.splitlines() if l.startswith("Accepted "))
    # One refused attempt can log several lines; count it once per source address and port.
    refused = len({m.group(1) for m in re.finditer(r"^(?:Invalid user|Failed ).* from (\S+ port \d+)", out, re.M)})
    return {"accepted_24h": accepted, "refused_24h": refused}


