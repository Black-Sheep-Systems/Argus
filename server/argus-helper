def heph_company_add(args):
    """heph-company-add <slug> <hexname>"""
    if len(args) != 2 or not SLUG_RE.fullmatch(args[0]):
        raise Refused("the short name is 2 to 40 lowercase letters, digits or hyphens")
    name = " ".join(unhex(args[1], 100).split())
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 &.,'()-]{0,99}", name) or any(w.startswith("-") for w in name.split()):
        raise Refused("use letters, numbers and spaces for the company name")
    NOTED.append(["heph-company-add", args[0], name])
    if any(t["slug"] == args[0] for t in heph_people([])["companies"]):
        raise Refused("a company with that short name already exists")
    heph_admin(["new-tenant", args[0]] + name.split())
    return {"slug": args[0], "name": name}


def heph_user_add(args):
    """heph-user-add <slug> <hexemail> <hexnames> tenant_user|tenant_tech|tenant_admin; password on stdin"""
    if len(args) != 4 or not SLUG_RE.fullmatch(args[0]) or args[3] not in ("tenant_user", "tenant_tech", "tenant_admin"):
        raise UnexpectedArgs()
    email, (first, last) = hx_email(args[1]), hx_names(args[2])
    NOTED.append(["heph-user-add", args[0], email, args[3]])
    if not any(t["slug"] == args[0] for t in heph_people([])["companies"]):
        raise Refused("there is no company with that short name")
    pw, generated = stdin_password()
    heph_admin(["new-user", args[0], email, first, last, "--role", args[3], "--password"], stdin_text=pw)
    return {"email": email, "company": args[0], "password": pw if generated else None}


def heph_user_op(args):
    """heph-user <hexemail> reset-totp|sign-out|set-password|reset-link"""
    if len(args) != 2 or args[1] not in ("reset-totp", "sign-out", "set-password", "reset-link"):
        raise UnexpectedArgs()
    email, op = hx_email(args[0]), args[1]
    NOTED.append(["heph-user", email, op])
    if op == "reset-totp":
        heph_admin(["reset-totp", email])
        return {"email": email, "done": op}
    if op == "sign-out":
        out = heph_admin(["revoke-sessions", email])
        return {"email": email, "done": op, "message": out.strip().splitlines()[-1][:120] if out.strip() else ""}
    if op == "set-password":
        pw, generated = stdin_password()
        heph_admin(["set-password", email], stdin_text=pw)
        return {"email": email, "done": op, "password": pw if generated else None}
    out = heph_admin(["reset-link", email, "4"])
    links = re.findall(r"https://\S+/reset/\S+", out)
    if not links:
        raise Refused("Hephaestus did not give a link")
    return {"email": email, "done": op, "link": links[0], "hours": 4}


# ---------- service versions and updates ----------
# Three kinds of service, updated three ways:
#   mailcow  - its containers move together with a mailcow release (update.sh)
#   image    - a ready-made image pinned to a tag: a patched build of the same
#              tag can be pulled; a newer version means editing the compose file
#   built    - built on this server from a Dockerfile: a patched base image
#              means rebuilding; Hephaestus has its own Deploy page
# Registry checks reach Docker Hub / ghcr.io from the server, so their result
# is kept in SVC_CACHE and refreshed every 6 hours or when Matt asks.
SVC_CACHE = "/var/lib/argus/service-updates.json"
SVC_MAX_AGE_S = 6 * 3600
MAILCOW_DIR = "/opt/mailcow-dockerized"
COMPOSE_ROOTS = ("/opt/",)
# Images built by hand (docker build) rather than by a compose "build:" line.
# Several compose projects use bss-php; a rebuild restarts all of them.
LOCAL_BUILDS = {"bss-php:8.5": "/opt/web/php"}
REG_ACCEPT = ("application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, "
              "application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json")


def split_ref(ref):
    """(registry, repository, tag) for an image reference. A pinned digest
    (name:tag@sha256:...) is ignored here; see pinned_digest()."""
    ref = ref.split("@", 1)[0]
    name, _, tag = ref.rpartition(":") if ":" in ref.split("/")[-1] else (ref, "", "latest")
    tag = tag or "latest"
    parts = name.split("/")
    if len(parts) > 1 and ("." in parts[0] or ":" in parts[0]):
        reg, repo = parts[0], "/".join(parts[1:])
    else:
        reg, repo = "docker.io", name if "/" in name else "library/" + name
    return reg, repo, tag


def reg_get(reg, repo, path, method="GET", accept=None):
    if reg == "docker.io":
        tok_url = "https://auth.docker.io/token?service=registry.docker.io&scope=repository:%s:pull" % repo
        base = "https://registry-1.docker.io"
    elif reg == "ghcr.io":
        tok_url, base = "https://ghcr.io/token?scope=repository:%s:pull" % repo, "https://ghcr.io"
    else:
        raise ValueError("registry not supported")
    with _urlreq.urlopen(tok_url, timeout=10) as r:
        tok = json.loads(r.read().decode())["token"]
    req = _urlreq.Request(base + "/v2/" + repo + path, method=method,
                          headers={"Authorization": "Bearer " + tok, "Accept": accept or "application/json"})
    return _urlreq.urlopen(req, timeout=15)


def remote_digest(ref):
    reg, repo, tag = split_ref(ref)
    with reg_get(reg, repo, "/manifests/" + tag, "HEAD", REG_ACCEPT) as r:
        d = r.headers.get("Docker-Content-Digest") or ""
    return d if DIGEST_RE.fullmatch(d) else None


DIGEST_RE = re.compile(r"^sha256:[0-9a-f]{64}$")


def pinned_digest(ref):
    d = ref.split("@", 1)[1] if "@" in ref else None
    return d if d and DIGEST_RE.fullmatch(d) else None


def local_digests(ref):
    out = run(["docker", "image", "inspect", "--format", "{{json .RepoDigests}}", ref])
    try:
        return [d.split("@", 1)[1] for d in json.loads(out or "[]") if "@" in d]
    except ValueError:
        return []


def tag_shape(tag):
    """'2.11.7' -> (r'^(\\d+)\\.(\\d+)\\.(\\d+)$', (2,11,7)); '17-bookworm' -> ... ; None if no version."""
    m = re.fullmatch(r"v?(\d+(?:\.\d+)*)(-[a-z0-9.-]+)?", tag)
    if not m:
        return None
    nums = tuple(int(x) for x in m.group(1).split("."))
    suffix = m.group(2) or ""
    pat = r"^v?" + r"\.".join([r"(\d+)"] * len(nums)) + re.escape(suffix) + "$"
    return pat, nums


def newest_tag(ref):
    """The highest tag of the same shape as the one in use (same suffix, same
    number of parts), e.g. caddy 2.11.7 -> 2.12.0; postgres 17-bookworm -> 18-bookworm."""
    reg, repo, tag = split_ref(ref)
    shape = tag_shape(tag)
    if not shape:
        return None
    pat, cur = shape
    tags, path = [], "/tags/list?n=10000"
    for _ in range(10):
        with reg_get(reg, repo, path) as r:
            tags += json.loads(r.read().decode()).get("tags") or []
            link = r.headers.get("Link")
        m = re.search(r"<([^>]+)>", link or "")
        if not m:
            break
        path = m.group(1).split("/v2/" + repo, 1)[-1]
    # Only the same major version, or the very next one: registries carry odd
    # tags (dates, build numbers) that would otherwise look like huge versions.
    best = cur
    for t in tags:
        m = re.fullmatch(pat, t)
        if m:
            v = tuple(int(x) for x in m.groups())
            if v > best and v[0] in (cur[0], cur[0] + 1):
                best = v
    if best == cur:
        return None
    suffix = re.fullmatch(r"v?\d+(?:\.\d+)*(-[a-z0-9.-]+)?", tag).group(1) or ""
    return ".".join(map(str, best)) + suffix, best[0] > cur[0]


_COMPOSE_CFG = {}


def compose_cfg(workdir):
    if workdir not in _COMPOSE_CFG:
        try:
            p = subprocess.run(["docker", "compose", "config", "--format", "json"], cwd=workdir, capture_output=True, text=True, timeout=30)
            _COMPOSE_CFG[workdir] = json.loads(p.stdout) if p.returncode == 0 else {}
        except (OSError, subprocess.TimeoutExpired, ValueError):
            _COMPOSE_CFG[workdir] = {}
    return _COMPOSE_CFG[workdir]


def compose_build(workdir, service):
    return ((compose_cfg(workdir).get("services") or {}).get(service) or {}).get("build")


def compose_dockerfile(workdir, service):
    b = compose_build(workdir, service)
    if not b:
        return None
    ctx = b.get("context") if isinstance(b, dict) else b
    return os.path.join(ctx, (b.get("dockerfile") if isinstance(b, dict) else None) or "Dockerfile")


def compose_base_images(workdir, service, image=None):
    """FROM images of a service built from a Dockerfile (its compose project's,
    or LOCAL_BUILDS for images built by hand)."""
    if image in LOCAL_BUILDS:
        df = os.path.join(LOCAL_BUILDS[image], "Dockerfile")
    else:
        b = compose_build(workdir, service)
        if not b:
            return None
        ctx = b.get("context") if isinstance(b, dict) else b
        df = os.path.join(ctx, (b.get("dockerfile") if isinstance(b, dict) else None) or "Dockerfile")
    bases = []
    try:
        with open(df) as f:
            for line in f:
                m = re.match(r"\s*FROM\s+(?:--platform=\S+\s+)?(\S+)", line, re.I)
                if m and "$" not in m.group(1) and m.group(1).lower() != "scratch":
                    bases.append(m.group(1))
    except OSError:
        return None
    stages = set()
    try:
        with open(df) as f:
            for line in f:
                m = re.match(r"\s*FROM\s+.*\s+AS\s+(\S+)\s*$", line, re.I)
                if m:
                    stages.add(m.group(1).lower())
    except OSError:
        return None
    return [x for x in bases if x.lower() not in stages]


def mailcow_versions():
    cur = None
    try:
        p = subprocess.run(["git", "-C", MAILCOW_DIR, "describe", "--tags", "--abbrev=0"], capture_output=True, text=True, timeout=15)
        cur = p.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        pass
    latest = None
    try:
        req = _urlreq.Request("https://api.github.com/repos/mailcow/mailcow-dockerized/releases/latest",
                              headers={"User-Agent": "argus-helper", "Accept": "application/vnd.github+json"})
        with _urlreq.urlopen(req, timeout=15) as r:
            latest = json.loads(r.read().decode()).get("tag_name")
    except Exception:
        pass
    return cur, latest


