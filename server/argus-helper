DB_IMAGES = ("postgres", "mysql", "mariadb")


def compose_dir_ok(wd):
    """A compose folder Argus may act in: a real folder under /opt (not
    mailcow's), owned by root and writable by nobody else. Returns the
    resolved path or None."""
    if not wd:
        return None
    rp = os.path.realpath(wd)
    if not re.fullmatch(r"/opt/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*", rp) or rp == MAILCOW_DIR or rp.startswith(MAILCOW_DIR + "/"):
        return None
    try:
        st = os.stat(rp)
    except OSError:
        return None
    if st.st_uid != 0 or st.st_mode & 0o022:
        return None
    return rp


SVC_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
# What uses each database, so a by-hand upgrade stops it first.
DB_USERS = {"hephaestus-prod-db-1": "the Hephaestus app (cd /opt/hephaestus/deploy && docker compose stop app)",
            "folio-db": "the Folio site (cd /opt/sites && docker compose stop php)",
