class Refused(Exception):
    """A request the helper will not carry out; the message says why."""


def no_args(args):
    if args:
        raise UnexpectedArgs()


def one_arg(args):
    if len(args) != 1:
        raise UnexpectedArgs()
    return args[0]


def must(cmd, timeout=90, pass_fds=()):
    """Run a fixed command that changes something; raise if it fails."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, pass_fds=pass_fds)
    except subprocess.TimeoutExpired:
        raise Refused("the command took too long")
    if p.returncode != 0:
        raise Refused((p.stderr or p.stdout).strip().splitlines()[-1][:200] if (p.stderr or p.stdout).strip() else "the command failed")
    return p.stdout


# ---------- read-only ----------

def activity(args):
    no_args(args)
    try:
        with open(LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 256 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()[-300:]
    except OSError:
        return []
    out = []
    for line in reversed(lines):
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


CHANGELOG_CACHE = "/var/cache/argus/changelogs"
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9+.-]{0,99}(:[a-z0-9]{1,20})?$")
VER_RE = re.compile(r"^[A-Za-z0-9.+~:-]{1,100}$")
URGENCY_RANK = {"low": 0, "medium": 1, "high": 2, "emergency": 3, "critical": 3}


def pkg_description(name):
    out = run(["apt-cache", "show", "--no-all-versions", name], timeout=10) or ""
    for line in out.splitlines():
        if line.startswith(("Description-en:", "Description:")):
            return line.split(":", 1)[1].strip()[:200] or None
    return None


def pkg_changes(name, old, new):
    """Change-log entries newer than the installed version: the highest
    urgency among them and what they say. Cached by package and versions."""
    key = os.path.join(CHANGELOG_CACHE, (name + "_" + (old or "") + "_" + new).replace(":", "%") + ".json")
    try:
        with open(key) as f:
            return json.load(f)
    except (OSError, ValueError):
        pass
    out = run(["apt-get", "-o", "Debug::NoLocking=1", "changelog", name], timeout=15)
    if not out:
        return {"urgency": None, "changes": []}
    urgency, changes, entries, first_version = None, [], 0, None
    for line in out.splitlines():
        m = re.match(r"^\S+ \((\S+)\) .*;\s*urgency=(\w+)", line)
        if m:
            ver, urg = m.group(1), m.group(2).lower()
            if first_version is None:
                first_version = ver
            if old and ver == old:
                break
            entries += 1
            if entries > 20:
                break
            if urgency is None or URGENCY_RANK.get(urg, 0) > URGENCY_RANK.get(urgency, 0):
                urgency = urg
            if entries > 1 and len(changes) < 12:
                changes.append("(" + ver + ")")
            continue
        if entries == 0 or line.startswith(" -- "):
            continue
        t = line.strip()
        if t and len(changes) < 12:
            changes.append(t[:160])
    if first_version != new:
        # Not the change log for the version on offer; say nothing rather
        # than something wrong, and do not keep it.
        return {"urgency": None, "changes": []}
    res = {"urgency": urgency, "changes": changes}
    try:
        os.makedirs(CHANGELOG_CACHE, mode=0o700, exist_ok=True)
        with open(key, "w") as f:
            json.dump(res, f)
    except OSError:
        pass
    return res


def prune_cache():
    cutoff = time.time() - 60 * 86400
    try:
        for e in os.listdir(CHANGELOG_CACHE):
            f = os.path.join(CHANGELOG_CACHE, e)
            if os.path.getmtime(f) < cutoff:
                os.remove(f)
    except OSError:
        pass


def need_level(source, security, urgency):
    """How soon to apply, from where Debian published the update:
      high   - Debian's security updates (it fixes a security problem),
               or marked high/emergency/critical by its maintainer;
      medium - stable-updates, which Debian keeps for fixes that cannot wait
               for the next point release (time zones, broken services);
      low    - an ordinary point-release update."""
    if security:
        return "high", "security"
    if URGENCY_RANK.get(urgency or "", 0) >= 2:
        return "high", "urgent"
    if "-updates" in source:
        return "medium", "stable-updates"
    return "low", "routine"


def updates_list(args):
    no_args(args)
    deadline = time.time() + 50   # the client waits 60 seconds in all
    out = run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "upgrade"], timeout=25)
    if out is None:
        raise Refused("could not read the update list")
    pkgs = []
    for line in out.splitlines():
        m = re.match(r"^Inst (\S+) (?:\[(\S+)\] )?\((\S+) (.*)\)", line)
        if not m:
            continue
        if not (PKG_RE.fullmatch(m.group(1)) and VER_RE.fullmatch(m.group(3))
                and (m.group(2) is None or VER_RE.fullmatch(m.group(2)))):
            pkgs.append({"name": m.group(1)[:100], "from": None, "to": "?", "source": "", "security": False,
                         "description": None, "urgency": None, "changes": [], "level": None, "why": "unreadable"})
            continue
        source = m.group(4).split()[0][:60]
        security = "security" in m.group(4).lower()
        level, why = need_level(source, security, None)
        pkgs.append({"name": m.group(1), "from": m.group(2), "to": m.group(3), "source": source,
                     "security": security, "level": level, "why": why})
    pkgs = pkgs[:60]
    prune_cache()

    def enrich(p):
        p["description"] = pkg_description(p["name"])
        ch = pkg_changes(p["name"], p["from"], p["to"])
        p["urgency"], p["changes"] = ch["urgency"], ch["changes"]
        p["level"], p["why"] = need_level(p["source"], p["security"], ch["urgency"])
        return p

    todo = [p for p in pkgs if p.get("why") != "unreadable"]
    ex = ThreadPoolExecutor(max_workers=8)
    futs = [ex.submit(enrich, p) for p in todo]
    wait(futs, timeout=max(3, deadline - time.time()))
    ex.shutdown(wait=False, cancel_futures=True)
    for p, f in zip(todo, futs):
        if not f.done() or f.exception():
            p.setdefault("description", None)
            p.setdefault("urgency", None)
            p["changes"] = []
    return pkgs


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def backup_list(args):
    no_args(args)
    res = {}
    for k, path in BACKUP_DIRS.items():
        items = []
        try:
            for e in sorted(os.listdir(path), reverse=True):
                if e.endswith(".part"):
                    continue
                full = os.path.join(path, e)
                st = os.lstat(full)
                size = dir_size(full) if os.path.isdir(full) else st.st_size
                items.append({"name": e, "size_b": size,
                              "time": datetime.datetime.fromtimestamp(st.st_mtime).astimezone().isoformat(timespec="minutes")})
        except OSError:
            items = None
        res[k] = items
    return res


def heph_images():
    out = run(["docker", "images", "hephaestus", "--format", "{{.Tag}}\t{{.ID}}\t{{.CreatedAt}}"])
    if out is None:
        raise Refused("could not list Hephaestus images")
    rows = [l.split("\t") for l in out.splitlines() if l.count("\t") == 2]
    live = next((r[1] for r in rows if r[0] == "local"), None)
    return live, rows


def rollback_list(args):
    no_args(args)
    live, rows = heph_images()
    seen, out = {live}, []
    for tag, iid, created in rows:
        if not TAG_RE.fullmatch(tag) or iid in seen:
            continue
        seen.add(iid)
        out.append({"tag": tag, "created": created})
        if len(out) >= 8:
            break
    return {"live_version": hephaestus()["version"], "choices": out}


def job_status(args):
    job = one_arg(args)
    if job not in JOBS:
        raise Refused("unknown job")
    active = unit_active("argus-" + job + ".service")
    try:
        with open(os.path.join(JOB_DIR, job + ".log"), errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return {"job": job, "running": active, "result": None, "log": []}
    result = None
    for line in reversed(lines):
        if line.startswith("ARGUS-RESULT: "):
            result = line.split(": ", 1)[1]
            break
    if result is None and not active:
        result = "interrupted"
    return {"job": job, "running": active, "result": result, "log": lines[-40:]}


