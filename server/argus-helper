def service_restart(args):
    name = one_arg(args)
    if not CONTAINER_RE.fullmatch(name):
        raise Refused("not a container name")
    out = run(["docker", "ps", "--format", "{{.Names}}"])
    if out is None or name not in out.split():
        raise Refused("no running container by that name")
    must(["docker", "restart", "-t", "30", name])
    return {"restarted": name}


BACKUP_UNITS = {"mail": "mailcow-backup.service", "hephaestus": "heph-db-backup.service"}


def backup_run(args):
    which = one_arg(args)
    if which not in BACKUP_UNITS:
        raise Refused("unknown backup")
    must(["systemctl", "start", "--no-block", BACKUP_UNITS[which]])
    return {"started": which}


class change_lock:
    """Only one change starts at a time (jobs and restarts share this)."""
    def __enter__(self):
        os.makedirs(JOB_DIR, mode=0o700, exist_ok=True)
        self.fd = os.open(os.path.join(JOB_DIR, ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise Refused("another change is starting; try again in a moment")
        why = busy_reason()
        if why:
            os.close(self.fd)
            raise Refused("not now: " + why)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)
        return False


def start_job(job, script, max_s=3600):
    """Run a fixed script as a background systemd unit with its own log.
    Only one change runs at a time: no job starts while another job, or apt,
    is busy."""
    unit = "argus-" + job
    with change_lock():
        logf = os.path.join(JOB_DIR, job + ".log")
        with open(logf, "w") as f:
            f.write("started " + datetime.datetime.now().astimezone().isoformat(timespec="seconds") + "\n")
        os.chmod(logf, 0o600)
        run(["systemctl", "reset-failed", unit + ".service"])
        # The script runs as its own shell, never inside an `if`: bash turns
        # off `set -e` and ERR traps for anything in an if-condition, which
        # would let a failed step carry on. It is judged only by its exit code.
        scriptf = os.path.join(JOB_DIR, job + ".sh")
        fd = os.open(scriptf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o700)
        with os.fdopen(fd, "w") as f:
            f.write("#!/bin/bash\n" + script + "\n")
        os.chmod(scriptf, 0o700)
        wrapped = ("exec >>" + logf + " 2>&1; /bin/bash " + scriptf + "; rc=$?; "
                   "if [ $rc = 0 ]; then echo 'ARGUS-RESULT: ok'; else echo \"ARGUS-RESULT: failed\"; exit 1; fi")
        must(["systemd-run", "--unit=" + unit, "--description=Argus " + job, "--property=Type=exec",
              "--property=RuntimeMaxSec=%d" % max_s, "/bin/bash", "-c", wrapped], timeout=20)
        return {"job": job, "started": True}


