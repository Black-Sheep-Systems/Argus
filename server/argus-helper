def heph_rollback(args):
    tag = one_arg(args)
    if not TAG_RE.fullmatch(tag):
        raise Refused("not a rollback tag")
    choices = [c["tag"] for c in rollback_list([])["choices"]]
    if tag not in choices:
        raise Refused("that image is not one of the rollback choices")
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    keep = "pre-argus-" + stamp
    version = tag[4:] if re.fullmatch(r"pre-[0-9a-f]{7,40}", tag) else "rollback to " + tag
    # The database and its migrations are left alone: only the app container
    # is recreated (--no-deps skips the migrate step). If the app is not
    # healthy within two minutes, what was live before is put back.
    script = (
        "set -e; cd " + HEPH_DEPLOY_DIR + "; "
        "docker tag hephaestus:local hephaestus:" + keep + "; "
        "echo 'Kept the current version as hephaestus:" + keep + "'; "
        "docker tag hephaestus:" + tag + " hephaestus:local; "
        "if ! docker compose up -d --no-deps --no-build app; then echo 'Could not start it; putting the previous version back.'; "
        "docker tag hephaestus:" + keep + " hephaestus:local; docker compose up -d --no-deps --no-build app; exit 1; fi; "
        "ok=0; for i in $(seq 1 24); do sleep 5; "
        "h=$(docker inspect -f '{{.State.Health.Status}}' hephaestus-prod-app-1 2>/dev/null || true); "
        "echo \"health: $h\"; if [ \"$h\" = healthy ]; then ok=1; break; fi; done; "
        "if [ $ok != 1 ]; then echo 'Not healthy after two minutes; putting the previous version back.'; "
        "docker tag hephaestus:" + keep + " hephaestus:local; docker compose up -d --no-deps --no-build app; exit 1; fi; "
        "printf '%s\\n' '" + version + "' > " + HEPH_VERSION_FILE + "; "
        "echo 'Running the server checks:'; "
        "out=$(HEPH_RESOLVE=desk.blksheepltd.com:443:127.0.0.1 bash scripts/verify.sh </dev/null 2>&1 || true); "
        "echo \"$out\" | tail -6; "
        "if ! echo \"$out\" | grep -Eq '[0-9]+ passed, 0 failed'; then "
        "echo 'The earlier version IS LIVE, but the server checks did not all pass (see above).'; exit 3; fi; "
        # keep only the three newest images Argus set aside
        "docker images hephaestus --format '{{.Tag}}' | grep '^pre-argus-' | sort -r | tail -n +4 "
        "| while read t; do docker rmi hephaestus:$t >/dev/null && echo \"Removed old copy $t\"; done; true"
    )
    return start_job("heph-rollback", script)


NOTE_OPS = ("upload", "download", "mkdir")


def note_file(args):
    """SFTP transfers do not pass through this helper, so Argus records each
    one here afterwards. The path arrives hex-encoded (only plain characters
    reach the command line) and is logged, cut to 300 characters."""
    if len(args) != 2 or args[0] not in NOTE_OPS or not re.fullmatch(r"[0-9a-f]{2,8192}", args[1]) or len(args[1]) % 2:
        raise UnexpectedArgs()
    path = bytes.fromhex(args[1]).decode("utf-8", "replace")
    NOTED.append([args[0], path[:300]])
    return {"noted": True}


NOTED = []


# ---------- safe file placement ----------
# Uploads arrive over SFTP (as root) in a new private temporary file next to
# the target. Everything that changes the real target happens here, through a
# handle on the folder itself and without ever following a link, so nobody
# who can write in that folder can redirect a root write elsewhere.

import stat as _stat
import shutil as _shutil

TMP_RE = re.compile(r"^\.argus-upload-[0-9a-f]{16}$")
OVERWRITE_ROOT = "/var/backups/argus"


def unhex(h, limit):
    if not re.fullmatch(r"[0-9a-f]{2,%d}" % (limit * 2), h) or len(h) % 2:
        raise UnexpectedArgs()
    return bytes.fromhex(h).decode("utf-8")


def plain_name(n):
    if not n or n in (".", "..") or "/" in n or "\0" in n or len(n) > 255:
        raise Refused("not a usable file name")
    return n


def open_dir(path):
    """A handle on an absolute folder, refusing any link along the way."""
    if not path.startswith("/") or "\0" in path:
        raise Refused("not a server path")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in [p for p in path.split("/") if p]:
            if part in (".", ".."):
                raise Refused("paths with .. are not accepted")
            try:
                nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError:
                raise Refused(path + " is not a folder (or goes through a link)")
            os.close(fd)
            fd = nfd
        return fd
    except BaseException:
        os.close(fd)
        raise


def keep_backup(dfd, name, target_path):
    """Copy the file about to be replaced to /var/backups/argus/<date>/<time>/<path>."""
    now = datetime.datetime.now()
    dest = os.path.join(OVERWRITE_ROOT, now.strftime("%Y-%m-%d"), now.strftime("%H%M%S")) + target_path
    os.makedirs(os.path.dirname(dest), mode=0o700, exist_ok=True)
    src = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
    try:
        if not _stat.S_ISREG(os.fstat(src).st_mode):
            raise Refused("the file being replaced is not a plain file")
        out = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(src, "rb", closefd=False) as fi, os.fdopen(out, "wb") as fo:
            _shutil.copyfileobj(fi, fo, 1024 * 1024)
    finally:
        os.close(src)
    return dest


def file_commit(args):
    """file-commit <hexdir> <tmpname> <hexname> <uid> <gid> <mode-octal> <0|1 replace>
    Put the uploaded temporary file in place as <name>, owned uid:gid with
    the given mode. With replace=1 the existing file must still be a plain
    file with exactly that owner and mode (what Matt confirmed); with 0 there
    must be no file of that name."""
    if len(args) != 7:
        raise UnexpectedArgs()
    d = unhex(args[0], 4096)
    tmp = args[1]
    name = plain_name(unhex(args[2], 255))
    if not TMP_RE.fullmatch(tmp) or not all(re.fullmatch(r"[0-9]{1,10}", x) for x in args[3:5]) \
            or not re.fullmatch(r"[0-7]{1,4}", args[5]) or args[6] not in ("0", "1"):
        raise UnexpectedArgs()
    uid, gid, mode, replace = int(args[3]), int(args[4]), int(args[5], 8), args[6] == "1"
    target_path = d.rstrip("/") + "/" + name
    web_lock = None
    if (os.path.normpath(target_path) + "/").startswith(WEB_DIR + "/"):
        # Under the same lock the web jobs start with, so none can start meanwhile.
        web_lock = change_lock()
        try:
            web_lock.__enter__()
        except Refused:
            raise Refused("another change is running; upload to /opt/web again when it has finished")
    try:
        NOTED.append(["upload", target_path[:300]])
        dfd = open_dir(d)
        try:
            st = os.stat(tmp, dir_fd=dfd, follow_symlinks=False)
            if not _stat.S_ISREG(st.st_mode) or st.st_uid != 0:
                raise Refused("the uploaded file is not where it should be")
            try:
                old = os.stat(name, dir_fd=dfd, follow_symlinks=False)
            except FileNotFoundError:
                old = None
            backup = None
            if replace:
                if old is None or not _stat.S_ISREG(old.st_mode) or old.st_uid != uid or old.st_gid != gid \
                        or _stat.S_IMODE(old.st_mode) != mode:
                    raise Refused(target_path + " changed on the server since you confirmed; look again")
                backup = keep_backup(dfd, name, target_path)
            elif old is not None:
                raise Refused(target_path + " appeared on the server since you confirmed; look again")
            tfd = os.open(tmp, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
            try:
                fst = os.fstat(tfd)
                if not _stat.S_ISREG(fst.st_mode) or fst.st_ino != st.st_ino or fst.st_nlink != 1 or fst.st_uid != 0:
                    raise Refused("the uploaded file changed before it could be placed")
                os.fchown(tfd, uid, gid)   # owner first: chown clears setuid/setgid
                os.fchmod(tfd, mode)
            finally:
                os.close(tfd)
            # rename never follows a link at the destination: it replaces the entry
            os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
            if backup:
                NOTED[-1].append("old copy kept in " + backup[:300])
            return {"target": target_path, "backup": backup}
        finally:
            os.close(dfd)
    finally:
        if web_lock is not None:
            web_lock.__exit__(None, None, None)


def file_discard(args):
    """file-discard <hexdir> <tmpname>: remove a temporary upload after a failure."""
    if len(args) != 2 or not TMP_RE.fullmatch(args[1]):
        raise UnexpectedArgs()
    dfd = open_dir(unhex(args[0], 4096))
    try:
        os.unlink(args[1], dir_fd=dfd)
    except FileNotFoundError:
        pass
    finally:
        os.close(dfd)
    return {"removed": True}


def file_mkdir(args):
    """file-mkdir <hexdir> <hexname>: new folder, owned like its parent, 0755."""
    if len(args) != 2:
        raise UnexpectedArgs()
    d = unhex(args[0], 4096)
    name = plain_name(unhex(args[1], 255))
    NOTED.append(["mkdir", (d.rstrip("/") + "/" + name)[:300]])
    dfd = open_dir(d)
    try:
        pst = os.fstat(dfd)
        try:
            os.mkdir(name, 0o700, dir_fd=dfd)
        except FileExistsError:
            raise Refused("something called " + name + " is already there")
        nfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
        try:
            os.fchown(nfd, pst.st_uid, pst.st_gid)
            os.fchmod(nfd, 0o755)
        finally:
            os.close(nfd)
        return {"path": d.rstrip("/") + "/" + name}
    finally:
        os.close(dfd)


# ---------- Hephaestus deploy ----------
# Same steps as the server chat's documented process (hephaestus-on-vps.md):
# the package holds only Cargo.toml, Cargo.lock, crates/, migrations/,
# deploy/ and tools/test/rls_invariants.sql; deploy/.env and
# deploy/docker-compose.vps.yml on the server are never replaced.

import tarfile as _tarfile

DEPLOY_DIR = "/var/lib/argus/deploy"
HEPH_DIR = "/opt/hephaestus"
COMMIT_RE = re.compile(r"^[0-9a-f]{7,40}$")
PACKAGE_TOP = ("Cargo.toml", "Cargo.lock", "crates", "migrations", "deploy", "tools")
PACKAGE_MAX = 300 * 1024 * 1024


def package_member_ok(m):
    n = m.name
    if n.startswith("/") or "\\" in n or any(p in ("..", "") for p in n.rstrip("/").split("/")):
        return False
    top = n.split("/")[0]
    if top not in PACKAGE_TOP:
        return False
    if top == "tools" and n.rstrip("/") not in ("tools", "tools/test", "tools/test/rls_invariants.sql"):
        return False
    base = n.rsplit("/", 1)[-1]
    # the server's own .env (and any copy of it) and compose overlay are never
    # part of a package; the template .env.example is.
    if n.startswith("deploy/") and ((base.startswith(".env") and base != ".env.example") or base == "docker-compose.vps.yml"):
        return False
    if "/target/" in "/" + n + "/":
        return False
    return m.isfile() or m.isdir()


def staged_dir(commit):
    return os.path.join(DEPLOY_DIR, "src-" + commit)


def heph_stage(args):
    """Check the uploaded package, unpack it beside the live source and list
    what would change. Nothing live is touched."""
    if len(args) != 2 or not TMP_RE.fullmatch(args[0]) or not COMMIT_RE.fullmatch(args[1]):
        raise UnexpectedArgs()
    tmp, commit = args
    NOTED.append(["stage", commit])
    with change_lock():   # never while a deploy (or any other change) runs
        return _heph_stage(tmp, commit)


PACKAGE_UNPACKED_MAX = 1024 * 1024 * 1024
PACKAGE_MEMBERS_MAX = 20000


def _heph_stage(tmp, commit):
    pkg = os.path.join(DEPLOY_DIR, tmp)
    st = os.lstat(pkg)
    if not _stat.S_ISREG(st.st_mode) or st.st_uid != 0:
        raise Refused("the uploaded package is not where it should be")
    try:
        if st.st_size > PACKAGE_MAX:
            raise Refused("the package is larger than expected")
        dest = staged_dir(commit)
        _shutil.rmtree(dest, ignore_errors=True)
        os.makedirs(dest, mode=0o700)
        with _tarfile.open(pkg, "r:*") as tf:
            members = tf.getmembers()
            if len(members) > PACKAGE_MEMBERS_MAX or sum(m.size for m in members) > PACKAGE_UNPACKED_MAX:
                _shutil.rmtree(dest, ignore_errors=True)
                raise Refused("the package unpacks to more than expected")
            bad = [m.name for m in members if not package_member_ok(m)]
            if bad:
                _shutil.rmtree(dest, ignore_errors=True)
                raise Refused("the package holds files it should not: " + ", ".join(bad[:5]))
            if not any(m.name == "Cargo.toml" for m in members) or not any(m.name.startswith("crates/") for m in members):
                _shutil.rmtree(dest, ignore_errors=True)
                raise Refused("this does not look like the Hephaestus source")
            tf.extractall(dest, members=members, filter="data")
    finally:
        try:
            os.unlink(pkg)
        except OSError:
            pass
    # what would change
    changes = []
    for part in PACKAGE_TOP:
        a, b = os.path.join(HEPH_DIR, part), os.path.join(dest, part)
        if part == "tools":
            a, b = os.path.join(HEPH_DIR, "tools/test/rls_invariants.sql"), os.path.join(dest, "tools/test/rls_invariants.sql")
        out = subprocess.run(["diff", "-rq", "-x", ".env*", "-x", "docker-compose.vps.yml", "-x", "target", a, b],
                             capture_output=True, text=True, timeout=60).stdout
        for line in out.splitlines():
            m = re.match(r"^Files (.+) and (" + re.escape(dest) + r"/.+) differ$", line)
            if m:
                changes.append({"change": "changed", "path": os.path.relpath(m.group(2), dest)})
                continue
            m = re.match(r"^Only in (.+?): (.+)$", line)
            if m:
                where, name = m.group(1), m.group(2)
                if where.startswith(dest):
                    changes.append({"change": "added", "path": os.path.relpath(os.path.join(where, name), dest)})
                else:
                    changes.append({"change": "removed", "path": os.path.relpath(os.path.join(where, name), HEPH_DIR)})
    live_m = set(os.listdir(os.path.join(HEPH_DIR, "migrations"))) if os.path.isdir(os.path.join(HEPH_DIR, "migrations")) else set()
    new_m = sorted(set(os.listdir(os.path.join(dest, "migrations"))) - live_m) if os.path.isdir(os.path.join(dest, "migrations")) else []
    with open(os.path.join(DEPLOY_DIR, "diff-" + commit + ".txt"), "w") as f:
        subprocess.run(["diff", "-ruN", "-x", ".env*", "-x", "docker-compose.vps.yml", "-x", "target",
                        "--label", "live", HEPH_DIR, dest], stdout=f, stderr=subprocess.DEVNULL, timeout=120)
    # remove older staged packages
    for e in os.listdir(DEPLOY_DIR):
        if (e.startswith("src-") and e != "src-" + commit) or (e.startswith("diff-") and e != "diff-" + commit + ".txt"):
            p = os.path.join(DEPLOY_DIR, e)
            _shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) else os.unlink(p)
    return {"commit": commit, "live_version": hephaestus()["version"], "changes": changes[:2000],
            "change_count": len(changes), "new_migrations": new_m}


def heph_diff(args):
    if len(args) != 1 or not COMMIT_RE.fullmatch(args[0]):
        raise UnexpectedArgs()
    try:
        with open(os.path.join(DEPLOY_DIR, "diff-" + args[0] + ".txt"), errors="replace") as f:
            text = f.read(512 * 1024)
    except OSError:
        raise Refused("that package is not staged; prepare it again")
    return {"diff": text, "cut": len(text) >= 512 * 1024}


def heph_deploy(args):
    """Background job, the documented process: back up the source, dump the
    database, keep the live image as pre-<live version>, copy the package in
    (keeping .env and docker-compose.vps.yml), build, start, wait for
    health (putting the previous version back if it does not come up), run
    the server checks, record the version."""
    if len(args) != 1 or not COMMIT_RE.fullmatch(args[0]):
        raise UnexpectedArgs()
    commit = args[0]
    src = staged_dir(commit)
    if not os.path.isfile(os.path.join(src, "Cargo.toml")):
        raise Refused("that package is not staged; prepare it again")
    live = hephaestus()["version"] or "unknown"
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    # The tag that keeps the live version. Never re-point an existing tag at a
    # different image: that would lose the real rollback copy.
    keep = "pre-" + live if re.fullmatch(r"[0-9a-f]{7,40}", live) else "pre-argus-" + stamp
    ids = {r[0]: r[1] for r in heph_images()[1]}
    if keep in ids and ids.get(keep) != ids.get("local"):
        keep = keep + "-" + stamp
    srcbak = "/root/config-backups-argus/hephaestus-pre-" + commit + "-" + stamp
    dump = "/root/heph-pre-" + commit + "-" + stamp + ".dump"
    excl = "--exclude /deploy/.env --exclude '/deploy/.env.*' --exclude /deploy/docker-compose.vps.yml --exclude target"
    script = (
        "set -eE -o pipefail; cd " + HEPH_DIR + "; COMMITTED=0; "
        # one way back, used by every failure after the live image was set aside
        "revert() { echo 'Something failed. Putting the previous version back.'; "
        "rsync -a --delete " + excl + " " + srcbak + "/ " + HEPH_DIR + "/; "
        "docker tag hephaestus:" + keep + " hephaestus:local; "
        "(cd " + HEPH_DIR + "/deploy && docker compose up -d --no-deps --no-build app) || echo 'Could not restart the previous version; check Hephaestus now.'; "
        "echo 'The previous version (" + live + ") is back. Any new database columns stay; they do no harm.'; }; "
        "trap 'rc=$?; trap - ERR; if [ $COMMITTED = 0 ] && [ -n \"$KEPT\" ]; then revert; fi; exit $rc' ERR; "
        "KEPT=; "
        "echo '1/8 Backing up the current source to " + srcbak + "'; "
        "mkdir -p /root/config-backups-argus; chmod 700 /root/config-backups-argus; "
        "rsync -a --exclude '/deploy/.env*' --exclude target " + HEPH_DIR + "/ " + srcbak + "/; "
        "echo '2/8 Saving the database to " + dump + "'; "
        "docker exec hephaestus-prod-db-1 pg_dump -U heph_owner -d heph -Fc > " + dump + ".part; "
        "mv " + dump + ".part " + dump + "; chmod 600 " + dump + "; "
        "echo '3/8 Keeping the live version as hephaestus:" + keep + "'; "
        "docker tag hephaestus:local hephaestus:" + keep + "; KEPT=1; "
        "echo '4/8 Copying the new source in (.env and docker-compose.vps.yml are kept)'; "
        "cp " + src + "/Cargo.toml " + src + "/Cargo.lock " + HEPH_DIR + "/; "
        "rsync -a --delete " + src + "/crates/ " + HEPH_DIR + "/crates/; "
        "rsync -a --delete " + src + "/migrations/ " + HEPH_DIR + "/migrations/; "
        "mkdir -p " + HEPH_DIR + "/tools/test; if [ -f " + src + "/tools/test/rls_invariants.sql ]; then cp " + src + "/tools/test/rls_invariants.sql " + HEPH_DIR + "/tools/test/; fi; "
        "rsync -a --delete --exclude /.env --exclude '/.env.*' --exclude /docker-compose.vps.yml " + src + "/deploy/ " + HEPH_DIR + "/deploy/; "
        "cd " + HEPH_DIR + "/deploy; docker compose config --quiet; "
        "echo '5/8 Building (several minutes; the live app keeps running)'; "
        "docker compose build app; "
        "echo '6/8 Applying database migrations'; "
        "docker compose run --rm migrate; "
        "echo '7/8 Starting the new version'; "
        "docker compose up -d; "
        "ok=0; for i in $(seq 1 24); do sleep 5; "
        "h=$(docker inspect -f '{{.State.Health.Status}}' hephaestus-prod-app-1 2>/dev/null || true); "
        "echo \"health: $h\"; if [ \"$h\" = healthy ]; then ok=1; break; fi; done; "
        "if [ $ok != 1 ]; then echo 'Not healthy after two minutes.'; false; fi; "
        "COMMITTED=1; "
        "printf '%s\\n' '" + commit + "' > " + HEPH_VERSION_FILE + "; "
        "rm -rf " + src + " " + DEPLOY_DIR + "/diff-" + commit + ".txt; "
        "echo '8/8 Running the server checks'; "
        "out=$(HEPH_RESOLVE=desk.blksheepltd.com:443:127.0.0.1 bash scripts/verify.sh </dev/null 2>&1 || true); "
        "echo \"$out\" | tail -6; "
        "if echo \"$out\" | grep -Eq '[0-9]+ passed, 0 failed'; then echo 'Hephaestus " + commit + " is live and the server checks passed.'; "
        "else echo 'Hephaestus " + commit + " IS LIVE, but the server checks did not all pass (see above). Roll back from this page if needed.'; exit 3; fi"
    )
    NOTED.append(["deploy", commit, "previous " + live + " kept as hephaestus:" + keep])
    return start_job("heph-deploy", script)


# ---------- mail (mailcow API, from the server itself only) ----------
# The API key stays in mailcow.conf (root, 0600) and is read here when needed;
# it is never printed or logged. Passwords arrive on stdin, never on the
# command line, and are never logged.

import urllib.request as _urlreq
import urllib.error as _urlerr
import secrets as _secrets
import string as _string

MAILCOW_CONF = "/opt/mailcow-dockerized/mailcow.conf"
MAILCOW_API = "http://127.0.0.1:8080/api/v1/"
EMAIL_RE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,253}\.[A-Za-z]{2,63}$")
LOCAL_RE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}$")
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([A-Za-z0-9-]{1,63}\.)+[A-Za-z]{2,63}$")
ID_RE = re.compile(r"^[0-9]{1,12}$")
QID_RE = re.compile(r"^[A-Za-z0-9]{6,40}$")


def mailcow_key():
    with open(MAILCOW_CONF) as f:
        for line in f:
            if line.startswith("API_KEY="):
                k = line.split("=", 1)[1].strip()
                if k:
                    return k
    raise Refused("the mail API is not switched on")


def mc(method, path, body=None, timeout=25):
    req = _urlreq.Request(MAILCOW_API + path, method=method,
                          data=None if body is None else json.dumps(body).encode(),
                          headers={"X-API-Key": mailcow_key(), "Content-Type": "application/json",
                                   "Accept": "application/json"})
    try:
        with _urlreq.urlopen(req, timeout=timeout) as r:
            data = json.loads(r.read().decode() or "null")
    except _urlerr.HTTPError as e:
        raise Refused("mailcow answered %s" % e.code)
    except (_urlerr.URLError, OSError, ValueError):
        raise Refused("could not reach mailcow (it may be restarting)")
    return data


def mc_change(path, body):
    """A change through the API. mailcow answers with a list of messages;
    any 'danger' or 'error' message means it was refused."""
    res = mc("POST", path, body)
    msgs = res if isinstance(res, list) else [res]
    bad = [m for m in msgs if isinstance(m, dict) and m.get("type") in ("danger", "error")]
    if bad:
        m = bad[0].get("msg")
        raise Refused("mailcow refused it: " + (json.dumps(m) if not isinstance(m, str) else m)[:200])
    # Only an explicit success counts: an empty or odd answer is not "done".
    if not any(isinstance(m, dict) and m.get("type") == "success" for m in msgs):
        raise Refused("mailcow did not confirm the change; look again before retrying")
    return msgs


def gen_password(n=20):
    alphabet = _string.ascii_letters + _string.digits
    while True:
        p = "".join(_secrets.choice(alphabet) for _ in range(n))
        if any(c.isdigit() for c in p) and any(c.islower() for c in p) and any(c.isupper() for c in p):
            return p


def stdin_password():
    """The password Matt typed, from stdin; "generate" asks for a new one."""
    data = sys.stdin.read(4096).strip("\n")
    if data == "generate":
        return gen_password(), True
    if len(data) < 12 or len(data) > 200 or any(ord(c) < 32 for c in data):
        raise Refused("the password must be 12 to 200 characters")
    return data, False


def hx_email(h):
    v = unhex(h, 320)
    if not EMAIL_RE.fullmatch(v) or v.startswith("-"):
        raise Refused("not an email address")
    return v.lower()


def mailcow_hostname():
    try:
        with open(MAILCOW_CONF) as f:
            for line in f:
                if line.startswith("MAILCOW_HOSTNAME="):
                    return line.split("=", 1)[1].strip().lower()
    except OSError:
        pass
    return None


def tfa_status():
    """Who has two-factor on, read straight from mailcow's database (read only).
    The database password stays inside the database container."""
    out = run(["docker", "exec", "mailcowdockerized-mysql-mailcow-1", "sh", "-c",
               'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -uroot -N -B "$MYSQL_DATABASE" '
               '-e "SELECT username, authmech, active FROM tfa"'], timeout=15)
    if out is None:
        return None
    res = {}
    for line in out.splitlines():
        f = line.split("\t")
        if len(f) == 3 and f[2] == "1":
            res.setdefault(f[0].lower(), []).append(f[1])
    return res


def mail_overview(args):
