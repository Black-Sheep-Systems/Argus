#!/usr/bin/python3 -I
"""argus-helper: the fixed list of things Argus may ask the server to do.

Run as: sudo -n /usr/local/sbin/argus-helper --session <id> <action> [args]
Every call is recorded in /var/log/argus/actions.log (time, session, action,
args, result; never output, never secrets). This is not a security boundary:
mattridge has full sudo. It keeps Argus's buttons to known, logged actions.

Actions:
  status                      read-only health report
  activity                    the last 300 entries of this log
  updates-list                packages waiting to update
  backup-list                 backups kept on the server
  rollback-list               earlier Hephaestus images to roll back to
  job-status <job>            progress of a background job
  service-restart <name>      restart one running container
  backup-run mail|hephaestus  start a backup now
  updates-apply               apply waiting updates (background job)
  reboot                      restart the server in one minute
  reboot-cancel               cancel a scheduled restart
  heph-rollback <tag>         put an earlier Hephaestus image live (background job)
  note-file <op> <hexpath>    record a file transfer Argus made over SFTP
  file-commit ...             put an uploaded temporary file in place safely
  file-mkdir <hexdir> <hexname>  new folder owned like its parent
  heph-stage <tmpname> <commit>  check and unpack an uploaded Hephaestus package
  heph-diff <commit>          the full changes a staged package would make
  heph-deploy <commit>        build and put a staged package live (background job)
  mail-overview               mailboxes, aliases, domains, two-factor status, queue and quarantine
  mail-dkim <hexdomain>       the DKIM record mailcow expects for a domain
  mailbox-add <hexlocal> <hexdomain> <quotaMB> <hexname>   password on stdin (or "generate")
  mailbox-set <hexmailbox> active|inactive|quota <MB>
  mailbox-password <hexmailbox>   new password on stdin (or "generate")
  mailbox-delete <hexmailbox>
  app-passwd-add <hexmailbox> <hexname>   returns a generated password once
  app-passwd-delete <id>
  alias-add <hexaddress> <hexgoto>
  alias-delete <id>
  mailq-flush | mailq-deliver <queueid> | mailq-delete <queueid>
  quarantine-release <id> | quarantine-delete <id>
  sites-list                  every site name: kind, answering, certificate days
  caddy-show                  the web server's configuration files (read only)
  caddy-check                 validate the configuration in a throwaway container
  caddy-apply                 check, keep the last good copy, restart, test every site (job)
  caddy-history               configurations kept from earlier applies
  caddy-rollback <stamp>      put a kept configuration back (job)
  cert-renew <hexname>        get a fresh certificate for one name (job)
  site-add static|redirect|proxy <hexdomain> [<hextarget>]  add a site (job)
  acct-list                   upload accounts, their keys and limits; Matt's own keys
  acct-folders                folders under /srv that can be shared with an upload account
  acct-mount-all              (at boot) connect every shared folder again
  acct-add <name> <hexlabel|none> <MB> own|<hexfolder>   returns the authenticator secret once
  acct-set <name> enable|disable | quota <MB> | label <hex|none> | new-code
  acct-delete <name>          the account goes; its files are kept
  key-add <account> <hexkey> | key-remove <account> <hexfingerprint>
  heph-people                 Hephaestus staff and companies
  heph-staff-add <hexemail> <hexnames> admin|technician   password on stdin
  heph-company-add <slug> <hexname>
  heph-user-add <slug> <hexemail> <hexnames> <role>   password on stdin
  heph-user <hexemail> reset-totp|sign-out|set-password|reset-link
  service-updates [refresh]   every service's version and any update (registry checks cached 6 h)
  service-update <container>|mailcow   apply an update Argus can make (job)
"""
