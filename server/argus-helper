    try:
        pam = open(PAM_SSHD).read()
    except OSError:
        pam = ""
    return {
        "quotas": quotas_on(),
        "authenticator_folder": bool(re.search(r"^auth\s+required\s+pam_google_authenticator\.so\s+secret=" + re.escape(GA_DIR) + r"/\$\{USER\}\s+user=root\s*$", pam, re.M)),
        "ssh_settings": upload_conf_ok(),
        "boot_mounts": os.path.isfile("/etc/systemd/system/argus-upload-mounts.service"),
    }


def need_ready():
    r = accounts_ready()
    missing = [k for k, v in r.items() if not v]
    if missing:
        raise Refused("the server's one-time setup for upload accounts is not finished (" + ", ".join(missing) + ")")


# --- shared folders

def served_paths():
    """Every /srv path a website serves or a container is set up to reach,
    from the configuration files: Caddy `root` lines in /opt/web, and any /srv
    path written anywhere in a compose file under /opt (one or two levels
    down). A file that can't be read stops the check rather than count as
    "nothing served"."""
    import glob as _glob
    out = set()
    for p in config_paths():
        if not os.path.exists(p):
            continue
        try:
            text = open(p).read()
        except OSError:
            raise Refused("could not read " + p + " to check what the websites serve")
        out.update(m.rstrip("/") for m in re.findall(r"^\s*root\s+(?:[*@]\S*\s+)?['\"]?(/srv/[^\s'\"}]+)", text, re.M))
    for p in sorted(set(_glob.glob("/opt/*/docker-compose*.y*ml") + _glob.glob("/opt/*/*/docker-compose*.y*ml")
                           + _glob.glob("/opt/*/compose.y*ml") + _glob.glob("/opt/*/*/compose.y*ml"))):
        try:
            text = open(p).read()
        except OSError:
            raise Refused("could not read " + p + " to check what the containers can reach")
        out.update(m.rstrip("/") for m in re.findall(r"(/srv(?=[\s:'\"/]|$)(?:/[A-Za-z0-9_.@-]+)*)", text, re.M))
    return out


def container_mount_sources():
    """What every container on the server (running or stopped, however it was
    started) actually has mounted. If Docker can't answer, nothing is shared."""
    ids = run(["docker", "ps", "-aq"], timeout=30)
    if ids is None:
        raise Refused("Docker did not answer, so it can't be checked that no container uses the folder")
    ids = ids.split()
    if not ids:
        return set()
    out = run(["docker", "inspect", "--format", "{{range .Mounts}}{{.Source}}\n{{end}}"] + ids, timeout=60)
    if out is None:
        raise Refused("Docker did not answer, so it can't be checked that no container uses the folder")
    srcs = {l.strip().rstrip("/") or "/" for l in out.splitlines() if l.strip()}
    return {x for x in srcs if x in ("/", "/srv") or x.startswith("/srv/")}


def all_served():
    return served_paths() | container_mount_sources()


def walk_no_links(path):
    """Open a folder one part at a time, never following a link. Returns the
    handle and the (uid, mode) of each folder above it from /srv down."""
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    above = []
    try:
        parts = [p for p in path.split("/") if p]
        for i, part in enumerate(parts):
            try:
                nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError:
                raise Refused(path + " is not a folder (or goes through a link)")
            os.close(fd)
            fd = nfd
            if i < len(parts) - 1:               # /srv, /srv/<site> ... parent of the target
                st = os.fstat(fd)
                above.append(("/" + "/".join(parts[:i + 1]), st.st_uid, st.st_mode))
        return fd, above
    except BaseException:
        os.close(fd)
        raise


def acl_has_write_for_others(path):
    out = run(["getfacl", "-c", "-p", "-E", path]) or ""
    for l in out.splitlines():
        kind, _, rest = l.partition(":")
        who, _, perm = rest.partition(":")
        if kind in ("user", "group") and who and "w" in perm:
            return True
    return False


def share_problem(path, served=None):
    """Why a folder can't be shared, or None. Only plain folders under a site's
    folder that no website serves, reached without links, with every folder
    above it owned by root and writable by nobody else."""
    if not SHARE_RE.fullmatch(path) or path != os.path.normpath(path):
        return "only plain folder names (letters, digits, . _ -) under /srv can be shared"
    top = path.split("/")[2]
    if top in NOT_SHAREABLE or len(path.split("/")) < 4:
        return "choose a folder inside one of the site folders under /srv"
    served = served_paths() if served is None else served
    for s in served:
        if s in ("/", "/srv") or path == s or path.startswith(s + "/") or s.startswith(path + "/"):
            return "that folder is (or holds) part of a live website or app; uploads there would go live"
    try:
        fd, above = walk_no_links(path)
    except Refused as e:
        return str(e)
    try:
        st = os.fstat(fd)
    finally:
        os.close(fd)
    if st.st_uid != 0:
        return "the folder must be owned by root (make it with Files, New Folder)"
    for p, uid, mode in above:
        if uid != 0 or mode & 0o022 or acl_has_write_for_others(p):
            return p + " can be changed by someone other than root, so folders under it can't be shared"
    return None


def acct_folders(args):
    """Folders that could be shared with an upload account, and why others can't."""
    no_args(args)
    served = all_served()
    ok = []
    for top in sorted(os.listdir(SITE_ROOT)):
        p = os.path.join(SITE_ROOT, top)
        if top in NOT_SHAREABLE or not os.path.isdir(p) or os.path.islink(p):
            continue
        for dirpath, dirs, _files in os.walk(p):
            dirs[:] = sorted(d for d in dirs if not os.path.islink(os.path.join(dirpath, d)))
            if dirpath.count("/") >= 4:
                dirs[:] = []
            if dirpath != p and share_problem(dirpath, served) is None:
                ok.append(dirpath)
            if len(ok) >= 200:
                break
    return {"folders": ok}


def read_mounts():
    try:
        with open(MOUNTS_FILE) as f:
            m = json.load(f)
        return {k: v for k, v in m.items() if ACCT_RE.fullmatch(k) and isinstance(v, str)}
    except (OSError, ValueError):
        return {}


def write_mounts(m):
    os.makedirs(os.path.dirname(MOUNTS_FILE), mode=0o700, exist_ok=True)
    fd, tmp = _tempfile.mkstemp(dir=os.path.dirname(MOUNTS_FILE), prefix=".upload-mounts-")
    with os.fdopen(fd, "w") as f:
        json.dump(m, f, indent=1, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.rename(tmp, MOUNTS_FILE)


def mount_root(target):
    out = run(["findmnt", "-n", "-o", "FSROOT", "--mountpoint", target])
    return out.strip() if out else None


def mount_share(n, src):
    """Bind src at the account's /files through a handle, never by path."""
    target = os.path.join(JAIL_ROOT, n, "files")
    why = share_problem(src)
    if why:
        raise Refused(why)
    fd, _ = walk_no_links(src)
    try:
        # --no-canonicalize: mount(2) gets /proc/self/fd/N, which the kernel
        # resolves to the opened folder itself, not to a path looked up again.
        must(["mount", "--no-canonicalize", "--bind", "/proc/self/fd/%d" % fd, target], pass_fds=(fd,))
    finally:
        os.close(fd)
    try:
        must(["mount", "-o", "remount,bind,nosuid,nodev,noexec", target])
    except BaseException:
        try_(must, ["umount", target])
        raise
    # FSROOT is the path within its filesystem; /srv is on / here, so it equals
    # src. (If /srv ever moves to its own disk, every share is refused: safe.)
    if mount_root(target) != src:
        try_(must, ["umount", target])
        raise Refused("the folder could not be connected safely; nothing was shared")


def acct_mount_all(args):
    """At boot: connect every shared folder again (checks repeated each time)."""
    no_args(args)
    done, failed = [], []
    for n, src in sorted(read_mounts().items()):
        target = os.path.join(JAIL_ROOT, n, "files")
        if is_mount(target):
            done.append(n)
            continue
        try:
            upload_account(n)
            mount_share(n, src)
            done.append(n)
        except Exception as e:
            failed.append(n + ": " + (str(e) if isinstance(e, Refused) else type(e).__name__))
    NOTED.append(["acct-mount-all", "%d connected" % len(done), "; ".join(failed)[:300]])
    return {"connected": done, "failed": failed}


# --- quota, keys, codes

def quota_report():
    """{user: (used_kb, limit_kb)} from repquota's csv; the header row is found by content."""
    txt = run(["repquota", "-u", "-O", "csv", "/"]) or ""
    rows = [[c.strip().strip('"') for c in r.split(",")] for r in txt.strip().splitlines()]
    head_i = next((i for i, r in enumerate(rows) if "blockused" in [c.lower() for c in r]), None)
    if head_i is None:
        return {}
    head = [c.lower() for c in rows[head_i]]
    iu = head.index("user") if "user" in head else 0
    iused, ihard = head.index("blockused"), head.index("blockhardlimit") if "blockhardlimit" in head else None
    out = {}
    for r in rows[head_i + 1:]:
        try:
            out[r[iu].lstrip("#")] = (int(r[iused]), int(r[ihard]) if ihard is not None else None)
        except (ValueError, IndexError):
            continue
    return out


def set_quota_mb(n, mb):
    kb = str(mb * 1024)
    must(["setquota", "-u", n, kb, kb, INODE_LIMIT, INODE_LIMIT, "/"])


def raw_key_file(account):
    path = ADMIN_KEYS if account == ADMIN_USER else os.path.join(KEYS_DIR, account)
    try:
        with open(path) as f:
            return path, f.read().splitlines()
    except FileNotFoundError:
        return path, []


def is_key_line(l):
    return l.strip() and not l.lstrip().startswith("#")


def key_info(line):
    """Fingerprint, type, size and comment of one authorized key line."""
    with _tempfile.NamedTemporaryFile("w", dir="/run", delete=True) as t:
        t.write(line + "\n")
        t.flush()
        out = run(["ssh-keygen", "-l", "-E", "sha256", "-f", t.name])
    if not out:
        return None
    m = re.match(r"^(\d+)\s+(SHA256:[A-Za-z0-9+/]{43})\s+(.*?)\s+\(([A-Z0-9-]+)\)\s*$", out.strip())
    if not m:
        return None
    return {"bits": int(m.group(1)), "fingerprint": m.group(2), "comment": m.group(3)[:80], "type": m.group(4)}


def list_keys(account):
    out = []
    for l in raw_key_file(account)[1]:
        if is_key_line(l):
            i = key_info(l)
            out.append(i if i else {"fingerprint": None, "type": "unreadable", "bits": 0, "comment": ""})
    return out


def key_account(name):
    return name if name == ADMIN_USER else upload_account(name)


def write_key_file(account, lines):
    """Replace a keys file in one step (comment lines kept), owner and mode kept."""
    path = ADMIN_KEYS if account == ADMIN_USER else os.path.join(KEYS_DIR, account)
    if account == ADMIN_USER:
        pw = _pwd.getpwnam(ADMIN_USER)
        uid, gid, mode = pw.pw_uid, pw.pw_gid, 0o600
    else:
        uid, gid, mode = 0, 0, 0o644
    fd, tmp = _tempfile.mkstemp(dir=os.path.dirname(path), prefix=".argus-keys-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write("".join(l + "\n" for l in lines))
        os.chown(tmp, uid, gid)
        os.chmod(tmp, mode)
        os.rename(tmp, path)
    except BaseException:
        try_(os.unlink, tmp)
        raise


def new_totp_file(path):
    """A google-authenticator secret file like the one Matt's own code uses.
    Returns the secret and five one-time emergency codes."""
    secret = _b64.b32encode(_secrets.token_bytes(20)).decode().rstrip("=")
    scratch = [str(10000000 + _secrets.randbelow(90000000)) for _ in range(5)]
    body = secret + "\n\" RATE_LIMIT 3 30\n\" WINDOW_SIZE 3\n\" DISALLOW_REUSE\n\" TOTP_AUTH\n" + "".join(s + "\n" for s in scratch)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    return secret, scratch


def totp_uri(account, secret):
    label = _urlparse.quote("Black Sheep server:" + account)
    return "otpauth://totp/" + label + "?secret=" + secret + "&issuer=" + _urlparse.quote("Black Sheep server")


# --- folder rights

def tree(folder):
    """Every folder and plain file under folder (same disk only), as handles
    opened without following links. Yields ("dir", fd) once per folder, then
    ("files", [O_PATH fds]) in batches of 200, closed after each batch. Links
    are never touched; a file that vanishes meanwhile is skipped, any other
    error stops the action."""
    import stat as _st
    top, _ = walk_no_links(folder)
    try:
        dev = os.fstat(top).st_dev
        for _root, dirs, files, rfd in os.fwalk(".", dir_fd=top, follow_symlinks=False):
            if os.fstat(rfd).st_dev != dev:
                dirs[:] = []
                continue
            yield "dir", rfd
            for i in range(0, len(files), 200):
                fds = []
                try:
                    for name in files[i:i + 200]:
                        try:
                            f = os.open(name, os.O_PATH | os.O_NOFOLLOW, dir_fd=rfd)
                        except FileNotFoundError:
                            continue
                        if _st.S_ISREG(os.fstat(f).st_mode):
                            fds.append(f)
                        else:
                            os.close(f)
                    yield "files", fds
                finally:
                    for f in fds:
                        try_(os.close, f)
    finally:
        os.close(top)


def setfacl_fds(opts, fds):
    """setfacl on handles (as /proc/self/fd/N), a batch at a time."""
    for i in range(0, len(fds), 200):
        part = fds[i:i + 200]
        must(["setfacl"] + opts + ["/proc/self/fd/%d" % f for f in part], timeout=120, pass_fds=tuple(part))


def acl_grant(folder, n):
    """Read everything already there; add new files and folders anywhere in it.
    The sticky bit stops the account renaming or deleting anyone else's files,
    and files others add later are only readable to it (so it can't grow
    root-owned files past its size limit)."""
    import stat as _st
    for kind, h in tree(folder):
        if kind == "dir":
            grant_keeping_mask(h, n, "rwx", ",d:u:" + n + ":rx")
            os.fchmod(h, _st.S_IMODE(os.fstat(h).st_mode) | _st.S_ISVTX)
        else:
            for f in h:
                grant_keeping_mask(f, n, "r")


def grant_keeping_mask(fd, n, perm, extra=""):
    """Add u:<n>:<perm> without letting setfacl recompute the mask from every
    entry: the mask only gains the bits this account needs, so a deliberately
    narrow mask stays as narrow as it can (and stays so after the account is
    removed, since removal keeps masks too)."""
    out = subprocess.run(["getfacl", "-c", "-p", "/proc/self/fd/%d" % fd], capture_output=True, text=True,
                         timeout=30, pass_fds=(fd,))
    if out.returncode != 0:
        raise Refused("could not read a file's permissions")
    mask = group = None
    for line in out.stdout.splitlines():
        if line.startswith("mask::"):
            mask = line.split("::", 1)[1][:3]
        elif line.startswith("group::"):
            group = line.split("::", 1)[1][:3]
    base = mask if mask is not None else (group or "---")
    new = "".join(c if (c in base or c in perm) else "-" for c in "rwx")
    setfacl_fds(["-n", "-m", "u:" + n + ":" + perm + ",m::" + new + extra], [fd])


def acl_revoke(folder, n, uid=None, gid=None):
    """Take the account's entries off the folder and everything under it, and
    hand anything it owned (by user or group) to root."""
    for kind, h in tree(folder):
        fds = [h] if kind == "dir" else h
        # -n: leave each mask as it is, so removing the entry widens nobody else.
        setfacl_fds(["-n", "-x", "u:" + n], fds)
        if kind == "dir":
            setfacl_fds(["-n", "-d", "-x", "u:" + n], fds)
        if uid is not None:
            for f in fds:
                st = os.fstat(f)
                if st.st_uid == uid or st.st_gid == gid:
                    if kind == "dir":
                        os.fchown(f, 0, 0)
                    else:
                        os.chown("/proc/self/fd/%d" % f, 0, 0)


def next_uid():
    """The next unused upload account number; numbers are never reused."""
    os.makedirs(os.path.dirname(UID_FILE), mode=0o700, exist_ok=True)
    try:
        n = int(open(UID_FILE).read().strip())
    except (OSError, ValueError):
        n = UID_START
    while n <= UID_END:
        try:
            _pwd.getpwuid(n)
        except KeyError:
            try:
                _grp.getgrgid(n)
            except KeyError:
                with open(UID_FILE + ".new", "w") as f:
                    f.write(str(n + 1) + "\n")
                os.rename(UID_FILE + ".new", UID_FILE)
                return n
        n += 1
    raise Refused("no upload account numbers are left")


def end_sessions(n):
    """Cut the account off and wait (up to 5 s) for its processes to go."""
    run(["pkill", "-KILL", "-u", n])
    for _ in range(25):
        if run(["pgrep", "-u", n]) is None:      # pgrep exits 1 when nothing matches
            return
        time.sleep(0.2)


# --- actions

def acct_list(args):
    no_args(args)
    mounts = read_mounts()
    quotas = quota_report()
    off = disabled_members()
    accounts = []
    for n in upload_members():
        try:
            upload_account(n)
            pw = _pwd.getpwnam(n)
        except (Refused, KeyError):
            continue
        used, limit = quotas.get(n, (None, None))
        src = mounts.get(n)
        target = os.path.join(JAIL_ROOT, n, "files")
        accounts.append({
            "name": n, "label": pw.pw_gecos.split(",")[0][:60],
            "folder": src or None, "own_folder": src is None,
            "used_kb": used, "limit_kb": limit, "disabled": n in off,
            "keys": list_keys(n),
            "authenticator": os.path.isfile(os.path.join(GA_DIR, n)),
            "mounted": (mount_root(target) == src) if src else None,
        })
    return {"ready": accounts_ready(), "accounts": accounts,
            "admin": {"name": ADMIN_USER, "keys": list_keys(ADMIN_USER)}}


def acct_add(args):
    """acct-add <name> <hexlabel|none> <quotaMB> own|<hexfolder>"""
    if len(args) != 4:
        raise UnexpectedArgs()
    n, mb, where = args[0], args[2], args[3]
    label = unhex(args[1], 60) if args[1] != "none" else ""
    if not ACCT_RE.fullmatch(n):
        raise Refused("use 3 to 31 lowercase letters, digits or hyphens, starting with a letter")
    if not LABEL_RE.fullmatch(label):
        raise Refused("use letters, numbers and spaces for the description")
    if not re.fullmatch(r"[1-9][0-9]{0,6}", mb) or int(mb) > 102400:
        raise Refused("the size limit is 1 to 102400 MB")
    src = None if where == "own" else unhex(where, 1024)
    NOTED.append(["acct-add", n, src or "own folder", mb + " MB"])
    need_ready()
    if src is not None:
        why = share_problem(src, all_served())
        if why:
            raise Refused(why)
    for look in (_pwd.getpwnam, _grp.getgrnam):
        try:
            look(n)
            raise Refused("a server account or group called " + n + " already exists")
        except KeyError:
            pass
    jail = os.path.join(JAIL_ROOT, n)
    files = os.path.join(jail, "files")
    done = []
    with change_lock():
        try:
            uid = next_uid()
            must(["groupadd", "--gid", str(uid), n])
            done.append("group")
            must(["useradd", "--no-create-home", "--home-dir", jail, "--shell", "/usr/sbin/nologin",
                  "--uid", str(uid), "--gid", str(uid), "--groups", UPLOAD_GROUP, "--comment", label or n, n])
            done.append("user")
            os.mkdir(jail, 0o755)
            os.chown(jail, 0, 0)
            done.append("jail")
            os.mkdir(files, 0o750)
            done.append("files")
            if src is None:
                os.chown(files, uid, uid)
            else:
                os.chown(files, 0, 0)
                done.append("acl")
                acl_grant(src, n)
                mount_share(n, src)
                done.append("mount")
                m = read_mounts()
                m[n] = src
                write_mounts(m)
                done.append("record")
            set_quota_mb(n, int(mb))
            done.append("quota")
            write_key_file(n, [])
            done.append("keys")
            secret, scratch = new_totp_file(os.path.join(GA_DIR, n))
            done.append("totp")
        except BaseException:
            # Put back only what this call made, each step on its own.
            if "record" in done:
                def drop():
                    m = read_mounts()
                    m.pop(n, None)
                    write_mounts(m)
                try_(drop)
            if "mount" in done:
                try_(must, ["umount", files])
            if "acl" in done:
                try_(acl_revoke, src, n)
            if "quota" in done:
                try_(run, ["setquota", "-u", n, "0", "0", "0", "0", "/"])
            if "keys" in done:
                try_(os.unlink, os.path.join(KEYS_DIR, n))
            if "totp" in done:
                try_(os.unlink, os.path.join(GA_DIR, n))
            # Never recurse: a folder that is still a mount is left for a person.
            if "files" in done and not is_mount(files):
                try_(os.rmdir, files)
            if "jail" in done and not is_mount(files):
                try_(os.rmdir, jail)
            if "user" in done:
                try_(run, ["userdel", n])
            if "group" in done:
                try_(run, ["groupdel", n])
            raise
    return {"name": n, "folder": src, "otpauth": totp_uri(n, secret), "secret": secret, "emergency_codes": scratch}


def acct_set(args):
    """acct-set <name> enable|disable | quota <MB> | label <hex|none> | new-code"""
    if len(args) < 2:
        raise UnexpectedArgs()
    n, op = upload_account(args[0]), args[1]
    if op in ("enable", "disable") and len(args) == 2:
        NOTED.append(["acct-set", n, op])
        with change_lock():
            if op == "disable":
                must(["gpasswd", "-a", n, DISABLED_GROUP])
                end_sessions(n)
            elif n in disabled_members():
                must(["gpasswd", "-d", n, DISABLED_GROUP])
        return {"name": n, "done": op}
    if op == "quota" and len(args) == 3:
        if not re.fullmatch(r"[1-9][0-9]{0,6}", args[2]) or int(args[2]) > 102400:
            raise Refused("the size limit is 1 to 102400 MB")
        NOTED.append(["acct-set", n, "quota", args[2] + " MB"])
        set_quota_mb(n, int(args[2]))
        return {"name": n, "done": "quota"}
    if op == "label" and len(args) == 3:
        label = unhex(args[2], 60) if args[2] != "none" else ""
        if not LABEL_RE.fullmatch(label):
            raise Refused("use letters, numbers and spaces for the description")
        NOTED.append(["acct-set", n, "label", label])
        must(["usermod", "--comment", label or n, n])
        return {"name": n, "done": "label"}
    if op == "new-code" and len(args) == 2:
        # A lost phone: a new secret replaces the old one; the old code stops working.
        NOTED.append(["acct-set", n, "new-code"])
        need_ready()
        path = os.path.join(GA_DIR, n)
        tmp = path + ".new"
        try_(os.unlink, tmp)
        secret, scratch = new_totp_file(tmp)
        os.rename(tmp, path)
        end_sessions(n)
        return {"name": n, "otpauth": totp_uri(n, secret), "secret": secret, "emergency_codes": scratch}
    raise UnexpectedArgs()


def acct_delete(args):
    """acct-delete <name>: the account goes; files it uploaded are kept.
    Its own folder is moved to /var/backups/argus, which the server's
    /etc/tmpfiles.d/argus.conf (`d /var/backups/argus 0700 root root 30d`)
    empties of anything untouched for 30 days; the chown below refreshes the
    folder's change time, so the 30 days start at deletion. Files it put in a
    shared folder stay, handed to root. Sticky bits set on shared folders stay."""
    n = upload_account(one_arg(args))
    NOTED.append(["acct-delete", n])
    jail = os.path.join(JAIL_ROOT, n)
    files = os.path.join(jail, "files")
    src = read_mounts().get(n)
    kept = None
    with change_lock():
        pw = _pwd.getpwnam(n)
        must(["gpasswd", "-a", n, DISABLED_GROUP])
        end_sessions(n)
        if src:
            if is_mount(files):
                must(["umount", files])
            if os.path.isdir(src) and share_problem(src) is None:
                acl_revoke(src, n, pw.pw_uid, pw.pw_gid)
            # Only now forget the share, so a failed clean-up is repeated by a retry.
            m = read_mounts()
            m.pop(n, None)
            write_mounts(m)
            if os.path.isdir(files) and not is_mount(files):
                os.rmdir(files)
        elif os.path.isdir(files) and not os.path.islink(files):
            if is_mount(files):
                raise Refused(files + " is unexpectedly a mount; nothing was deleted")
            os.makedirs(OVERWRITE_BACKUPS, mode=0o700, exist_ok=True)
            kept = os.path.join(OVERWRITE_BACKUPS, "account-" + n + "-" + time.strftime("%Y%m%d-%H%M%S"))
            os.rename(files, kept)                 # /srv and /var/backups are on the same disk
            must(["chown", "-R", "-h", "root:root", kept], timeout=600)   # also restarts its 30 days
        run(["setquota", "-u", n, "0", "0", "0", "0", "/"])
        for p in (os.path.join(KEYS_DIR, n), os.path.join(GA_DIR, n)):
            try_(os.unlink, p)
        must(["userdel", n])
        try:
            _grp.getgrnam(n)
            run(["groupdel", n])
        except KeyError:
            pass
        if not is_mount(files):
            try_(os.rmdir, files)
            try_(os.rmdir, jail)
    return {"name": n, "deleted": True, "kept": kept}


def key_add(args):
    """key-add <account> <hexkey>: one public key line, no options."""
    if len(args) != 2:
        raise UnexpectedArgs()
    acct = key_account(args[0])
    line = " ".join(unhex(args[1], 1000).strip().split())
    parts = line.split(" ")
    if len(parts) < 2 or parts[0] not in KEY_TYPES or not re.fullmatch(r"[A-Za-z0-9+/]+={0,3}", parts[1]):
        raise Refused("that is not a public key line (it should start with ssh-ed25519, ecdsa-... or ssh-rsa)")
    comment = " ".join(parts[2:])
    if not re.fullmatch(r"[A-Za-z0-9@._ +-]{0,80}", comment):
        raise Refused("the key's comment has characters that aren't accepted")
    line = parts[0] + " " + parts[1] + (" " + comment if comment else "")
    info = key_info(line)
    if not info:
        raise Refused("that key could not be read")
    if info["type"] == "RSA" and info["bits"] < 3072:
        raise Refused("RSA keys must be at least 3072 bits; an ed25519 key is better")
    NOTED.append(["key-add", acct, info["fingerprint"], info["comment"]])
    _, lines = raw_key_file(acct)
    if any(is_key_line(l) and (key_info(l) or {}).get("fingerprint") == info["fingerprint"] for l in lines):
        raise Refused("that key is already there")
    write_key_file(acct, lines + [line])
    return {"account": acct, "added": info}


def key_remove(args):
    """key-remove <account> <hexfingerprint>"""
    if len(args) != 2:
        raise UnexpectedArgs()
    fp = unhex(args[1], 60)
    if not FP_RE.fullmatch(fp):
        raise UnexpectedArgs()
    acct = key_account(args[0])
    NOTED.append(["key-remove", acct, fp])
    _, lines = raw_key_file(acct)
    keep = [l for l in lines if not (is_key_line(l) and (key_info(l) or {}).get("fingerprint") == fp)]
    if len(keep) == len(lines):
        raise Refused("that key is not there")
    if acct == ADMIN_USER and not any(is_key_line(l) for l in keep):
        raise Refused("that is your last key; add another one first, or you could not sign in")
    write_key_file(acct, keep)
    if acct != ADMIN_USER:
        end_sessions(acct)
    return {"account": acct, "removed": fp}


# Hephaestus users, through heph-admin inside the running app container.
def heph_admin(argv, stdin_text=None, timeout=60):
    if any(a.startswith("-") and a not in ("--admin", "--role", "--password") for a in argv):
        raise Refused("a value can't start with -")
    try:
        p = subprocess.run(["docker", "compose", "exec", "-T", "app", "heph-admin"] + argv, cwd=HEPH_DEPLOY_DIR,
                           input=(stdin_text + "\n") if stdin_text is not None else "", capture_output=True,
                           text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Refused("Hephaestus took too long to answer")
    if p.returncode != 0:
        msg = [l for l in (p.stderr or "").splitlines() if l.strip() and not l.lower().startswith(("new password", "password ("))]
        raise Refused("Hephaestus refused it: " + (msg[-1].strip()[:200] if msg else "is it running?"))
    return p.stdout


def heph_people(args):
    no_args(args)
    staff = []
    for l in heph_admin(["list-staff"]).splitlines():
        p = l.split()
        if len(p) >= 4 and EMAIL_RE.fullmatch(p[0]):
            staff.append({"email": p[0], "role": p[1], "active": p[2] == "active", "two_factor": " ".join(p[3:5]) == "2fa on"})
    tenants = []
    for l in heph_admin(["list-tenants"]).splitlines():
        p = l.split(None, 1)
        if len(p) == 2 and SLUG_RE.fullmatch(p[0]):
            tenants.append({"slug": p[0], "name": p[1].strip()})
    return {"staff": staff, "companies": tenants}


def hx_names(h):
    """First and last name, sent together as hex of "first<TAB>last"."""
    parts = unhex(h, 130).split("\t")
    if len(parts) != 2 or not all(PERSON_RE.fullmatch(p.strip()) for p in parts):
        raise Refused("use letters for the first and last name")
    return parts[0].strip(), parts[1].strip()


def heph_staff_add(args):
