# ---------- websites (Caddy, /opt/web) ----------
# The admin API is off, so a change means a restart (every site blips for a
# second or two). The files that make up the configuration are snapshotted
# after every successful apply, so a later one can be undone.

WEB_DIR = "/opt/web"
WEB_FILES = ("Caddyfile", "site-rules.caddy", "docker-compose.yml")      # plus sites/*.caddy
CADDY = "bss-caddy"
CADDY_HISTORY = "/var/lib/argus/caddy-history"
SERVER_IP = "129.121.98.1"
STAMP_RE = re.compile(r"^\d{8}-\d{6}$")


def site_blocks():
    """[(names, body)] for each site block in the Caddyfile."""
    blocks, cur, depth = [], None, 0
    with open(os.path.join(WEB_DIR, "Caddyfile")) as f:
        for line in f:
            stripped = line.strip()
            if depth == 0:
                m = re.match(r"^([a-z0-9.,: *-]+)\{\s*$", line)
                if m:
                    cur = ([n for n in re.split(r"[,\s]+", m.group(1)) if n], [])
                    depth = 1
                continue
            depth += line.count("{") - line.count("}")
            if depth <= 0:
                blocks.append((cur[0], "".join(cur[1])))
                depth, cur = 0, None
            else:
                cur[1].append(line)
    return blocks


def block_kind(body):
    if re.search(r"^\s*redir\s", body, re.M) and not re.search(r"^\s*(root|reverse_proxy|import)\s", body, re.M):
        return "redirect"
    if re.search(r"reverse_proxy\s+(127\.0\.0\.1|localhost):", body):
        return "app"
    if re.search(r"^\s*(root|import /etc/caddy/(sites|site-rules))", body, re.M):
        return "site"
    return "other"


def http_code(name):
    try:
        p = subprocess.run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "8",
                            "--resolve", name + ":443:127.0.0.1", "https://" + name + "/"],
                           capture_output=True, text=True, timeout=12)
        return int(p.stdout or 0)
    except Exception:
        return 0


def all_codes(names):
    with ThreadPoolExecutor(max_workers=16) as ex:
        return dict(zip(names, ex.map(http_code, names)))


def sites_list(args):
    no_args(args)
    blocks = site_blocks()
    names = [n for ns, _ in blocks for n in ns if re.fullmatch(r"[a-z0-9.-]+", n)]
    with ThreadPoolExecutor(max_workers=16) as ex:
        days = dict(zip(names, ex.map(cert_days, names)))
    codes = all_codes(names)
    out = []
    for ns, body in blocks:
        kind = block_kind(body)
        target = None
        m = re.search(r"redir\s+(\S+)", body) if kind == "redirect" else re.search(r"reverse_proxy\s+(\S+)", body) if kind == "app" else re.search(r"root \* (\S+)", body)
        if m:
            target = m.group(1)
        else:
            m = re.search(r"import /etc/caddy/sites/(\S+)", body)
            if m:
                try:
                    with open(os.path.join(WEB_DIR, "sites", os.path.basename(m.group(1)))) as f:
                        r = re.search(r"root \* (\S+)", f.read())
                        target = r.group(1) if r else None
                except OSError:
                    pass
        for n in ns:
            if re.fullmatch(r"[a-z0-9.-]+", n):
                out.append({"name": n, "kind": kind, "target": target, "http": codes.get(n), "cert_days": days.get(n)})
    hist = caddy_history([])
    return {"sites": out, "changed_since_apply": config_differs(hist[0]["stamp"]) if hist else None,
            "last_applied": hist[0]["stamp"] if hist else None}


def config_paths():
    paths = [os.path.join(WEB_DIR, f) for f in WEB_FILES]
    sd = os.path.join(WEB_DIR, "sites")
    if os.path.isdir(sd):
        paths += sorted(os.path.join(sd, f) for f in os.listdir(sd) if f.endswith(".caddy"))
    return paths


def caddy_show(args):
    """The configuration files, read only. caddy.env (a secret) and the agent
    allow-list (Matt's home address) are never shown."""
    no_args(args)
    out = []
    for p in config_paths():
        try:
            with open(p, errors="replace") as f:
                out.append({"file": os.path.relpath(p, WEB_DIR), "text": f.read(200000)})
        except OSError:
            pass
    return out


def caddy_image_and_mounts():
    out = run(["docker", "inspect", "-f", "{{.Config.Image}}\t{{json .Mounts}}", CADDY])
    if not out:
        raise Refused("the web server container is not there")
    image, mounts = out.strip().split("\t", 1)
    vols = []
    for m in json.loads(mounts):
        src = m.get("Source") if m.get("Type") == "bind" else m.get("Name")
        if src and m.get("Destination"):
            vols += ["-v", src + ":" + m["Destination"] + ":ro"]
    return image, vols


def caddy_data_dir():
    out = run(["docker", "inspect", "-f", "{{json .Mounts}}", CADDY])
    for m in json.loads(out or "[]"):
        if m.get("Destination") == "/data" and m.get("Type") == "bind":
            return m["Source"]
    raise Refused("could not find the web server's data folder")


def caddy_validate():
    """Validate in a throwaway copy of the web server: same image, same files
    (read only), no network. Nothing live is touched."""
    image, vols = caddy_image_and_mounts()
    try:
        # Caddy opens its log files while validating: give it an empty, temporary
        # log folder so the live logs are never touched.
        p = subprocess.run(["docker", "run", "--rm", "--network", "none", "--env-file", os.path.join(WEB_DIR, "caddy.env"),
                            *vols, "--tmpfs", "/data/logs", image, "caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"],
                           capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return False, "the check took too long"
    return p.returncode == 0, mask_secrets((p.stdout + p.stderr).strip())


def mask_secrets(text):
    """Caddy can echo substituted values in its errors. Hide every value from
    caddy.env and everything in the agent allow-list (Matt's home address)."""
    secrets_ = []
    try:
        with open(os.path.join(WEB_DIR, "caddy.env")) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    v = line.split("=", 1)[1].strip().strip('"').strip("'")
                    if len(v) >= 4:
                        secrets_.append(v)
    except OSError:
        pass
    try:
        with open(os.path.join(WEB_DIR, "agent-allow", "allow.caddy")) as f:
            allow = f.read()
            secrets_ += re.findall(r"[0-9]{1,3}(?:\.[0-9]{1,3}){3}(?:/[0-9]{1,2})?", allow)
            secrets_ += [m for m in re.findall(r"[0-9A-Fa-f:]{3,}(?:/[0-9]{1,3})?", allow) if m.count(":") >= 2]
    except OSError:
        pass
    for v in sorted(set(secrets_), key=len, reverse=True):
        text = text.replace(v, "[hidden]")
        if "/" in v:
            text = text.replace(v.split("/")[0], "[hidden]")
    lines = [l for l in text.splitlines() if "HEPH_PROXY_SECRET" not in l and "allow.caddy" not in l]
    return "\n".join(lines[-25:])


def caddy_check(args):
    no_args(args)
    ok, msg = caddy_validate()
    return {"valid": ok, "message": msg}


def snapshot_config(dest):
    _shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(os.path.join(dest, "sites"), mode=0o700, exist_ok=True)
    for p in config_paths():
        rel = os.path.relpath(p, WEB_DIR)
        _shutil.copy2(p, os.path.join(dest, rel))


def config_differs(stamp):
    d = os.path.join(CADDY_HISTORY, stamp)
    for p in config_paths():
        q = os.path.join(d, os.path.relpath(p, WEB_DIR))
        try:
            if open(p, "rb").read() != open(q, "rb").read():
                return True
        except OSError:
            return True
    kept = set(os.listdir(os.path.join(d, "sites"))) if os.path.isdir(os.path.join(d, "sites")) else set()
    now = set(os.path.basename(p) for p in config_paths() if "/sites/" in p)
    return kept != now


def caddy_history(args):
    no_args(args)
    try:
        stamps = sorted((e for e in os.listdir(CADDY_HISTORY) if STAMP_RE.fullmatch(e)), reverse=True)
    except OSError:
        stamps = []
    return [{"stamp": s_} for s_ in stamps[:20]]


def web_job_script(restore_from, label, extra_prep="", test_names=None, extra_undo="", after=""):
    """Shared shape of every web server change, run as a background job:
    remember how each site answers, (make Argus's own change,) check,
    restart, test again, and put the last good configuration back if a site
    that answered before now fails.
    Matt's own edits that fail the check are left as they are (nothing was
    restarted). Whenever something is put back, the files as they were are
    kept first in caddy-history/failed-<stamp>, so no edit is ever lost."""
    names = test_names if test_names is not None else [n for ns, _ in site_blocks() for n in ns if re.fullmatch(r"[a-z0-9.-]+", n)]
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    H = "/usr/local/sbin/argus-helper --session job-web-" + stamp[-6:]
    keepdir = CADDY_HISTORY + "/failed-" + stamp
    snap = CADDY_HISTORY + "/" + stamp
    return (
        "set -eE -o pipefail; cd " + WEB_DIR + "; RESTORED=0; UNDO=0; "
        "copyset() { rm -rf \"$2\"; mkdir -p \"$2/sites\"; cp -a \"$1\"/Caddyfile \"$1\"/site-rules.caddy \"$1\"/docker-compose.yml \"$2\"/; "
        "if ls \"$1\"/sites/*.caddy >/dev/null 2>&1; then cp -a \"$1\"/sites/*.caddy \"$2\"/sites/; fi; }; "
        "restore() { set +e; echo 'Keeping the files as they are now in " + keepdir + "'; copyset " + WEB_DIR + " " + keepdir + "; "
        "echo 'Putting the last good configuration back.'; "
        "cp -a " + restore_from + "/Caddyfile " + restore_from + "/site-rules.caddy " + restore_from + "/docker-compose.yml " + WEB_DIR + "/; "
        "rm -f " + WEB_DIR + "/sites/*.caddy; cp -a " + restore_from + "/sites/. " + WEB_DIR + "/sites/; "
        + extra_undo +
        "docker compose up -d caddy >/dev/null 2>&1; docker restart " + CADDY + " >/dev/null; sleep 4; RESTORED=1; "
        "echo 'The last good configuration is back.'; }; "
        "trap 'rc=$?; trap - ERR; if [ $RESTORED = 0 ] && [ $UNDO = 1 ]; then restore; fi; exit $rc' ERR; "
        "code() { curl -s -o /dev/null -w '%{http_code}' -m 8 --resolve \"$1:443:127.0.0.1\" \"https://$1/\" || true; }; "
        "echo '1. How each site answers now'; declare -A BEFORE; "
        "for n in " + " ".join(names) + "; do BEFORE[$n]=$(code $n); done; "
        + ("UNDO=1; " + extra_prep if extra_prep else "") +
        "echo '2. Checking the configuration'; "
        "CHECK=$(" + H + " caddy-check); "
        "if ! echo \"$CHECK\" | grep -q '\"valid\": true'; then echo \"$CHECK\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"message\"])'; "
        "echo 'The configuration did not pass the check. The web server was not restarted.'; false; fi; "
        "echo '3. Restarting the web server (every site blips for a second or two)'; UNDO=1; "
        "docker compose up -d caddy; docker restart " + CADDY + " >/dev/null; sleep 5; "
        "echo '4. Testing every site again'; BROKEN=0; "
        "for n in " + " ".join(names) + "; do a=${BEFORE[$n]}; b=$(code $n); "
        "if [ \"$a\" != 000 ] && [ \"$a\" -lt 400 ] && { [ \"$b\" = 000 ] || [ \"$b\" -ge 400 ]; }; then echo \"  $n broke: was $a, now $b\"; BROKEN=1; "
        "elif [ \"$a\" != 000 ] && [ \"$a\" -lt 500 ] && { [ \"$b\" = 000 ] || [ \"$b\" -ge 500 ]; }; then echo \"  $n broke: was $a, now $b\"; BROKEN=1; fi; done; "
        "if [ $BROKEN = 1 ]; then false; fi; "
        + after +
        "UNDO=0; copyset " + WEB_DIR + " " + snap + "; chmod 700 " + CADDY_HISTORY + "; "
        "ls -1d " + CADDY_HISTORY + "/2*/ 2>/dev/null | sort -r | tail -n +21 | xargs -r rm -rf; "
        "ls -1d " + CADDY_HISTORY + "/failed-*/ 2>/dev/null | sort -r | tail -n +11 | xargs -r rm -rf; "
        "echo '" + label + "'"
    )


def last_good():
    h = caddy_history([])
    if not h:
        raise Refused("no good configuration has been kept yet")
    return os.path.join(CADDY_HISTORY, h[0]["stamp"])


def ensure_history():
    """The first time, keep the configuration that is live now as the first
    good copy, but only if no file has changed since the web server last
    started (otherwise the files on disk may hold edits that were never live)."""
    if caddy_history([]):
        return
    started = run(["docker", "inspect", "-f", "{{.State.StartedAt}}", CADDY])
    try:
        # Docker gives UTC, e.g. 2026-10-26T04:21:33.123456789Z
        t = datetime.datetime.strptime(started.strip()[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).timestamp()
    except Exception:
        raise Refused("could not tell when the web server started, so no first good copy was kept")
    newest = max(os.path.getmtime(p_) for p_ in config_paths())
    if newest > t:
        raise Refused("the files in /opt/web changed after the web server last started, so Argus cannot tell "
                      "which configuration is live. Put the files back as they were (the Files page keeps copies) "
                      "and try again, or ask for the first copy to be set up by hand")
    os.makedirs(CADDY_HISTORY, mode=0o700, exist_ok=True)
    snapshot_config(os.path.join(CADDY_HISTORY, datetime.datetime.now().strftime("%Y%m%d-%H%M%S")))


def no_unapplied_edits():
    """Argus's own web changes (rollback, certificate, new site) restart the web
    server with whatever is on disk; refuse while Matt has edits not yet applied."""
    if config_differs(caddy_history([])[0]["stamp"]):
        raise Refused("the files in /opt/web have edits that were never applied: Apply them (or undo them) first")


def caddy_apply(args):
    no_args(args)
    NOTED.append(["caddy-apply"])
    ensure_history()
    if not config_differs(caddy_history([])[0]["stamp"]):
        raise Refused("nothing has changed since the last apply")
    return start_job("web", web_job_script(last_good(), "The new configuration is live and every site that answered before still does."))


def caddy_rollback(args):
    if len(args) != 1 or not STAMP_RE.fullmatch(args[0]):
        raise UnexpectedArgs()
    src = os.path.join(CADDY_HISTORY, args[0])
    if not os.path.isdir(src):
        raise Refused("that configuration is not kept")
    NOTED.append(["caddy-rollback", args[0]])
    ensure_history()
    no_unapplied_edits()
    now_names = set(n for ns, _ in site_blocks() for n in ns if re.fullmatch(r"[a-z0-9.-]+", n))
    then_names = set()
    for line in open(os.path.join(src, "Caddyfile")):
        m = re.match(r"^([a-z0-9.,: -]+)\{\s*$", line)
        if m:
            then_names |= set(n for n in re.split(r"[,\s]+", m.group(1)) if n)
    removed = sorted(now_names - then_names)
    prep = ("echo 'Copying the configuration from " + args[0] + " in'; "
            "cp -a " + src + "/Caddyfile " + src + "/site-rules.caddy " + src + "/docker-compose.yml " + WEB_DIR + "/; "
            "rm -f " + WEB_DIR + "/sites/*.caddy; cp -a " + src + "/sites/. " + WEB_DIR + "/sites/; ")
    label = "The configuration from " + args[0] + " is live." + (" Names no longer served: " + ", ".join(removed) + "." if removed else "")
    return start_job("web", web_job_script(last_good(), label, prep, test_names=sorted(now_names & then_names)))


def cert_renew(args):
    """Set the certificate for one name aside so Caddy fetches a new one.
    That name is left out of the normal test and waited for separately (up
    to 90 seconds); if no new certificate arrives, the old one is put back."""
    if len(args) != 1:
        raise UnexpectedArgs()
    name = unhex(args[0], 253).lower()
    names = [n for ns, _ in site_blocks() for n in ns if re.fullmatch(r"[a-z0-9.-]+", n)]
    if name not in names:
        raise Refused("that name is not served here")
    NOTED.append(["cert-renew", name])
    ensure_history()
    no_unapplied_edits()
    base = os.path.join(caddy_data_dir(), "caddy", "certificates")
    dirs = [os.path.join(base, issuer, name) for issuer in (os.listdir(base) if os.path.isdir(base) else [])
            if os.path.isdir(os.path.join(base, issuer, name))]
    if not dirs:
        raise Refused("no certificate for " + name + " was found to renew")
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    aside = "/root/config-backups-argus/cert-" + name + "-" + stamp
    moves = "".join("mkdir -p " + aside + "/" + str(i) + "; mv " + d + " " + aside + "/" + str(i) + "/; " for i, d in enumerate(dirs))
    putback = "".join("rm -rf " + d + "; mv " + aside + "/" + str(i) + "/" + name + " " + d + "; " for i, d in enumerate(dirs))
    prep = "echo 'Setting the old certificate for " + name + " aside (kept in " + aside + ")'; mkdir -p /root/config-backups-argus; " + moves
    after = ("echo '5. Waiting for the new certificate (up to 90 seconds)'; GOT=0; for i in $(seq 1 18); do "
             "d=$(echo | openssl s_client -connect 127.0.0.1:443 -servername " + name + " 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null || true); "
             "if [ -n \"$d\" ]; then GOT=1; echo \"  new certificate: $d\"; break; fi; sleep 5; done; "
             "if [ $GOT = 0 ]; then echo 'No new certificate arrived.'; false; fi; ")
    others = [n for n in names if n != name]
    return start_job("web", web_job_script(last_good(), "A new certificate for " + name + " is in place.", prep,
                                           test_names=others, extra_undo=putback, after=after))


SITE_TEMPLATE = """# {domain}: added by Argus {date}.
root * /srv/{domain}/public
encode zstd gzip
header {{
\t-Server
\tX-Content-Type-Options nosniff
\tReferrer-Policy strict-origin-when-cross-origin
\tX-Frame-Options SAMEORIGIN
\tStrict-Transport-Security "max-age=31536000"
}}
@forbidden path_regexp forbid (?i)(^|/)\\.[^/]+
respond @forbidden 404
file_server
"""


def site_add(args):
    if len(args) not in (2, 3) or args[0] not in ("static", "redirect", "proxy"):
        raise UnexpectedArgs()
    kind, domain = args[0], unhex(args[1], 253).lower()
    if not DOMAIN_RE.fullmatch(domain) or domain.startswith("www."):
        raise Refused("give the domain without www (for example example.com)")
    existing = [n for ns, _ in site_blocks() for n in ns]
    if domain in existing or "www." + domain in existing:
        raise Refused(domain + " is already served here")
    target = unhex(args[2], 300) if len(args) == 3 else None
    date = datetime.date.today().isoformat()
    if kind == "static":
        block = ("\n# " + domain + " (added by Argus " + date + ")\n" + domain + " {\n\timport /etc/caddy/sites/" + domain + ".caddy\n}\n"
                 "www." + domain + " {\n\tredir https://" + domain + "{uri} 308\n}\n")
    elif kind == "redirect":
        if not target or not re.fullmatch(r"https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~/-]*)?", target):
            raise Refused("the redirect target must be an https:// address")
        block = ("\n# " + domain + " (added by Argus " + date + ")\n" + domain + ", www." + domain + " {\n\tredir " + target.rstrip("/") + "{uri} 308\n}\n")
    else:
        if not target or not re.fullmatch(r"[0-9]{2,5}", target) or not (1024 <= int(target) <= 65535):
            raise Refused("give the local port the app listens on (1024 to 65535)")
        block = ("\n# " + domain + " (added by Argus " + date + ")\n" + domain + " {\n\tencode zstd gzip\n\treverse_proxy 127.0.0.1:" + target + "\n}\n"
                 "www." + domain + " {\n\tredir https://" + domain + "{uri} 308\n}\n")
    NOTED.append(["site-add", kind, domain, target or ""])
    ensure_history()
    no_unapplied_edits()
    prep = "echo 'Adding " + domain + "'; "
    if kind == "static":
        site_file = SITE_TEMPLATE.format(domain=domain, date=date)
        prep += ("mkdir -p /srv/" + domain + "/public; chmod 755 /srv/" + domain + " /srv/" + domain + "/public; "
                 "[ -e /srv/" + domain + "/public/index.html ] || printf '%s\\n' '<!doctype html><title>" + domain + "</title><p>Coming soon.</p>' > /srv/" + domain + "/public/index.html; "
                 "cat > " + WEB_DIR + "/sites/" + domain + ".caddy <<'ARGUS_EOF'\n" + site_file + "ARGUS_EOF\n"
                 # mount the new folder into the web server, read only
                 "python3 -I -c 'import sys,re; p=sys.argv[1]; s=open(p).read(); line=\"      - /srv/" + domain + "/public:/srv/" + domain + "/public:ro\\n\"; "
                 "i=s.index(\"      - ./site-rules.caddy:/etc/caddy/site-rules.caddy:ro\\n\"); s=s[:i]+line+s[i:]; open(p,\"w\").write(s)' " + WEB_DIR + "/docker-compose.yml; ")
    prep += "cat >> " + WEB_DIR + "/Caddyfile <<'ARGUS_EOF'\n" + block + "ARGUS_EOF\n"
    out = start_job("web", web_job_script(last_good(), domain + " is set up on the server. Its certificate arrives once the DNS records point here.", prep))
    out["dns"] = [{"type": "A", "name": domain, "value": SERVER_IP}, {"type": "A", "name": "www." + domain, "value": SERVER_IP}]
    return out


class UnexpectedArgs(Exception):
    pass


# ---------- accounts: upload accounts, SSH keys, Hephaestus users ----------
# Upload accounts are SFTP-only (no links, no hard links), locked in
# /srv/sftp/<name> (root-owned, as sshd's ChrootDirectory requires). They see
# one folder at /files: either their own (/srv/sftp/<name>/files) or a folder
# Matt shares from under /srv. A shared folder is bind-mounted by this helper,
# through a handle opened without following links (never by path from
# /etc/fstab), at creation and at every boot (argus-upload-mounts.service).
# Keys live in /etc/ssh/argus-keys/<name> and authenticator secrets in
# /var/lib/google-authenticator/<name>: root-owned and outside every jail.
# sshd's rules for the argus-upload group are fixed in
# /etc/ssh/sshd_config.d/60-argus-upload.conf; members of argus-disabled are
# refused by 05-argus-deny.conf. Account numbers come from a counter and are
# never reused, so a new account can never inherit an old one's files.
import base64 as _b64
import pwd as _pwd
import grp as _grp
import tempfile as _tempfile
import urllib.parse as _urlparse
import shlex as _shlex

ADMIN_USER = "mattridge"
ADMIN_KEYS = "/home/mattridge/.ssh/authorized_keys"
UPLOAD_GROUP = "argus-upload"
DISABLED_GROUP = "argus-disabled"
JAIL_ROOT = "/srv/sftp"
KEYS_DIR = "/etc/ssh/argus-keys"
GA_DIR = "/var/lib/google-authenticator"
PAM_SSHD = "/etc/pam.d/sshd"
SSHD_UPLOAD_CONF = "/etc/ssh/sshd_config.d/60-argus-upload.conf"
SSHD_DENY_CONF = "/etc/ssh/sshd_config.d/05-argus-deny.conf"
UPLOAD_FORCE = "ForceCommand internal-sftp -d /files -u 0027 -P symlink,hardlink -l INFO -f AUTHPRIV"
MOUNTS_FILE = "/var/lib/argus/upload-mounts.json"
UID_FILE = "/var/lib/argus/upload-uid"
UID_START = 30000
UID_END = 59999
INODE_LIMIT = "200000"
SITE_ROOT = "/srv"
NOT_SHAREABLE = ("sftp", "newsdesk-releases")
ACCT_RE = re.compile(r"^[a-z][a-z0-9-]{2,30}$")
SHARE_RE = re.compile(r"^/srv(/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}){1,8}$")
FP_RE = re.compile(r"^SHA256:[A-Za-z0-9+/]{43}$")
KEY_TYPES = {"ssh-ed25519", "sk-ssh-ed25519@openssh.com", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384",
             "ecdsa-sha2-nistp521", "sk-ecdsa-sha2-nistp256@openssh.com", "ssh-rsa"}
PERSON_RE = re.compile(r"^[A-Za-z][A-Za-z' .-]{0,59}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,39}$")
LABEL_RE = re.compile(r"^[A-Za-z0-9 ._'-]{0,60}$")


def is_mount(path):
    """True if something is mounted exactly at path. (os.path.ismount says no
    for a bind mount from the same disk, which is what shares are.)"""
    want = os.path.normpath(path)
    try:
        with open("/proc/self/mountinfo") as f:
            for line in f:
                mp = line.split(" ")[4]
                mp = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), mp)
                if mp == want:
                    return True
    except OSError:
        return True          # can't tell: behave as if it is, so nothing is removed
    return False


def try_(fn, *a, **k):
    """Run one clean-up step; a failure must not stop the next one."""
    try:
        fn(*a, **k)
    except Exception:
        pass


def upload_members():
    try:
        return sorted(_grp.getgrnam(UPLOAD_GROUP).gr_mem)
    except KeyError:
        return []


def disabled_members():
    try:
        return set(_grp.getgrnam(DISABLED_GROUP).gr_mem)
    except KeyError:
        return set()


def upload_account(name):
    """An existing upload account: in the group AND numbered from the upload
    range (so never mattridge, root or a system user)."""
    if not ACCT_RE.fullmatch(name) or name == ADMIN_USER or name not in upload_members():
        raise Refused("no upload account by that name")
    try:
        pw = _pwd.getpwnam(name)
    except KeyError:
        raise Refused("no upload account by that name")
    if not UID_START <= pw.pw_uid <= UID_END:
        raise Refused(name + " is not an upload account")
    return name


def quotas_on():
    # quotaon -p reports through its exit code the other way round (non-zero
    # when quotas ARE on), so only its words are read.
    try:
        out = subprocess.run(["quotaon", "-p", "-u", "/"], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return " is on" in out


def upload_conf_ok():
    try:
        conf = open(SSHD_UPLOAD_CONF).read()
    except OSError:
        return False
    return any(l.strip() == UPLOAD_FORCE for l in conf.splitlines()) and os.path.isfile(SSHD_DENY_CONF)


def accounts_ready():
