def how_to(kind, c, newer=None, major=False):
    """The steps to do it by hand (shown to Matt, never run). Commands are only
    built from checked folder and service names, each one quoted."""
    q = _shlex.quote
    wd = compose_dir_ok(c.get("workdir"))
    svc = c.get("service") if SVC_NAME_RE.fullmatch(c.get("service") or "") else None
    name = c.get("name") if CONTAINER_RE.fullmatch(c.get("name") or "") else None
    if kind == "mailcow":
        return ["Argus does this with Update Mail System: it takes a mail backup, then runs mailcow's own updater (twice, if the updater first updates itself).",
                "By hand: cd " + MAILCOW_DIR + " && ./update.sh --check, then ./update.sh (answer its questions).",
                "Mail is unavailable for a few minutes while the containers are replaced."]
    if kind == "heph":
        return ["Hephaestus is updated from your code on the Hephaestus page (Deploy), which checks, builds and rolls back by itself if needed."]
    if kind == "rebuild-image":
        img, src = c["image"], LOCAL_BUILDS[c["image"]]
        users = image_users(img)
        recreate = " ; ".join("(cd " + q(w) + " && docker compose up -d --no-deps --force-recreate " + q(sv) + ")" for w, sv, _ in users)
        return ["Argus does this with Update: it keeps the current build as " + img.split(":")[0] + ":before-update, rebuilds " + img
                + " from " + src + " on the newest base image, then restarts every container that uses it.",
                "By hand: docker tag " + q(img) + " " + q(img.split(":")[0] + ":before-update") + " && docker build --pull -t " + q(img) + " " + q(src)
                + (" && " + recreate if recreate else ""),
                "To undo: docker tag " + q(img.split(":")[0] + ":before-update") + " " + q(img) + (" && " + recreate if recreate else "")]
    if not (wd and svc):
        return ["This service's folder can't be used safely from here (it must be a root-owned folder under /opt), so no commands are given. Ask the server chat."]
    if kind == "repin":
        old = c["image"]
        new = old.split("@", 1)[0] + "@" + newer
        return ["This service is pinned to an exact build in " + wd + "'s compose file, on purpose: it can only change when the file says so.",
                "1. In " + wd + "'s compose file, change the image line for " + svc + " from " + old + " to " + new,
                "2. cd " + q(wd) + " && docker compose pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc),
                "3. Check the service works. To undo, put the old line back and run step 2 again."]
    if kind == "recreate":
        return ["Argus does this with Update: it restarts this container onto the image that is already downloaded.",
                "By hand: cd " + q(wd) + " && docker compose up -d --no-deps --force-recreate " + q(svc)]
    if kind == "patched":
        return ["Argus does this with Update: it keeps the current image as argus-rollback/" + (name or "?").lower() + ":before-update, downloads the patched build of the same version and restarts only this service.",
                "By hand: cd " + q(wd) + " && docker compose pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc)]
    if kind == "rebuild":
        return ["Argus does this with Update: it rebuilds this service on the newest build of its base image, then restarts it.",
                "By hand: cd " + q(wd) + " && docker compose build --pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc)]
    if kind == "newer-base":
        df = c.get("dockerfile") or "its Dockerfile"
        rebuild = ("docker build --pull -t " + q(c["image"]) + " " + q(LOCAL_BUILDS[c["image"]]) + ", then restart its containers (see the Update steps above)"
                   if c["image"] in LOCAL_BUILDS else "cd " + q(wd) + " && docker compose build --pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc))
        return ["1. Read the release notes for " + newer + " (for PHP: the migration guide for the new version).",
                "2. In " + df + ", change the FROM line to the new tag (" + newer + ").",
                "3. Rebuild: " + rebuild,
                "4. Check the sites or apps that use it. To undo, put the old FROM line back and rebuild the same way."] + (
                ["Note: the image is called " + c["image"] + "; after this it holds the new version, so consider renaming the tag."] if c["image"] in LOCAL_BUILDS else [])
    repo = split_ref(c["image"])[1].split("/")[-1]
    stop = DB_USERS.get(name, "the apps that use it")
    dump = "/root/" + (name or "db") + "-dump.sql"
    if repo == "postgres" and major:
        return ["1. Read the release notes for PostgreSQL " + newer + ".",
                "2. Stop " + stop + " so nothing is written after the dump.",
                "3. Dump everything: docker exec " + q(name) + " sh -c 'pg_dumpall -U \"$POSTGRES_USER\"' > " + q(dump),
                "4. A new major PostgreSQL can't read the old data files. In " + wd + "'s compose file change the tag to " + newer
                + " and give it a new, empty data volume. (From version 18 the volume is mounted at /var/lib/postgresql, not /var/lib/postgresql/data.)",
                "5. Start it: cd " + q(wd) + " && docker compose up -d --no-deps " + q(svc),
                "6. Load the dump: docker exec -i " + q(name) + " sh -c 'psql -U \"$POSTGRES_USER\" -d postgres' < " + q(dump),
                "7. Start the apps again and check them. Keep the old volume and the dump until you're sure; to undo, put the old tag and volume back.",
                "The server chat can do this with you; it isn't a one-button job because a failed migration can lose data."]
    if repo in ("mysql", "mariadb") and major:
        tool, pw = ("mariadb-dump", "$MARIADB_ROOT_PASSWORD") if repo == "mariadb" else ("mysqldump", "$MYSQL_ROOT_PASSWORD")
        steps = ["1. Read the release notes for " + repo + " " + newer + "."]
        if repo == "mysql":
            steps.append("Note: MySQL 9.x releases are short-lived Innovation releases; 8.4 is the long-term (LTS) line, which Argus keeps patched. Staying on 8.4 is the normal choice.")
        steps += ["2. Stop " + stop + ".",
                  "3. This database isn't on the Backups page, so dump its own databases first (not the built-in mysql schema): docker exec " + q(name)
                  + " sh -c '" + tool + " -uroot -p\"" + pw + "\" --single-transaction --routines --triggers --events --databases <your databases>' > " + q(dump),
                  "4. " + repo + " upgrades its data files in place when the new version first starts, but can't go back afterwards. In " + wd + "'s compose file change the tag to " + newer + ".",
                  "5. cd " + q(wd) + " && docker compose pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc) + ", then watch docker logs " + q(name) + " until the upgrade finishes.",
                  "6. Start the apps again and check them. To undo: the old version can't read the upgraded files; restore the dump into a fresh volume on the old tag."]
        return steps
    pinned = pinned_digest(c["image"])
    base_ref = c["image"].split("@", 1)[0].rsplit(":", 1)[0]
    change = ("3. This service is pinned to an exact build, and Docker ignores the tag when a build is pinned. In " + wd + "'s compose file replace the whole image "
              + c["image"] + " with " + base_ref + ":" + newer + "@<its build id>, which docker buildx imagetools inspect " + q(base_ref + ":" + newer)
              + " shows as Digest (or drop the @sha256:... part to stop pinning)."
              if pinned else "3. In " + wd + "'s compose file change the image tag for " + svc + " to " + newer + ".")
    return ["1. Read the release notes for " + repo + " " + newer + " for anything that changed in how it is set up.",
            "2. Back up anything that uses this service" + (" (it isn't on the Backups page: dump it first)" if repo in DB_IMAGES else "") + ".",
            change,
            "4. cd " + q(wd) + " && docker compose pull " + q(svc) + " && docker compose up -d --no-deps " + q(svc),
            "5. Check the service works; to undo, put the old " + ("image line" if pinned else "tag") + " back and run step 4 again."]


def check_services():
    """The slow part: every container, its version, and what update (if any) exists."""
    rows = container_table()
    mc_cur, mc_latest = mailcow_versions()
    images = {r["image"] for r in rows if r["project"] != "mailcowdockerized"}
    built = {}
    for r in rows:
        if r["image"] in LOCAL_BUILDS or (r["project"] != "mailcowdockerized" and r["workdir"] and os.path.isdir(r["workdir"])
                                          and (r["image"] == "hephaestus:local" or compose_build(r["workdir"], r["service"]))):
            built.setdefault(r["image"], r)
    remote, newer, bases = {}, {}, {}

    def look(ref):
        try:
            remote[ref] = remote_digest(ref)
        except Exception:
            remote[ref] = None
        try:
            newer[ref] = newest_tag(ref)
        except Exception:
            newer[ref] = "unknown"

    targets = set(i for i in images if i not in built)
    for img, r in built.items():
        bl = compose_base_images(r["workdir"], r["service"], img) or []
        bases[img] = bl
        targets.update(bl)
    with ThreadPoolExecutor(max_workers=6) as ex:
        list(ex.map(look, sorted(targets)))

    ids = {}
    out_rows = []
    for r in sorted(rows, key=lambda x: (x["project"] != "mailcowdockerized", x["name"])):
        tag = split_ref(r["image"])[2]
        item = {"name": r["name"], "image": r["image"], "version": tag, "kind": "image", "status": "unknown",
                "detail": "", "can_update": False, "how": []}
        if r["image"] not in ids:
            ids[r["image"]] = image_id(r["image"])
        stale_copy = ids[r["image"]] and r["image_id"] and ids[r["image"]] != r["image_id"] and r["project"] != "mailcowdockerized" \
            and r["image"] != "hephaestus:local"
        if stale_copy:
            # The tag already points at a newer image (another project pulled it,
            # or a rebuild missed this one): only a restart onto it is needed.
            item.update(status="update", detail="running an older copy of " + r["image"] + "; restart it onto the current one",
                        can_update=True, action="recreate", how=how_to("recreate", r))
            out_rows.append(item)
            continue
        if r["project"] == "mailcowdockerized":
            item["kind"] = "mailcow"
            item["version"] = tag + (" · mailcow " + mc_cur if mc_cur else "")
            if mc_cur and mc_latest:
                if mc_latest != mc_cur:
                    item.update(status="update", detail="mailcow " + mc_latest + " is out (you have " + mc_cur + ")", can_update=True,
                                action="mailcow", how=how_to("mailcow", r))
                else:
                    item.update(status="current", detail="mailcow " + mc_cur + " is the latest release")
            else:
                item["detail"] = "could not reach mailcow's release list"
        elif r["image"] == "hephaestus:local":
            item.update(kind="built", version=heph_deployed() or "local", status="own",
                        detail="your code; deploy new versions from the Hephaestus page", how=how_to("heph", r))
        elif r["image"] in built:
            item["kind"] = "built"
            item["version"] = tag + " · built here"
            bl = bases.get(r["image"]) or []
            stale = [b for b in bl if remote.get(b) and remote[b] not in local_digests(b)]
            newer_base = [(b, newer.get(b)) for b in bl if isinstance(newer.get(b), tuple)]
            if not bl:
                item.update(status="unknown", detail="its Dockerfile could not be read")
            elif stale:
                shared = [u_[2] for u_ in image_users(r["image"])] if r["image"] in LOCAL_BUILDS else [r["name"]]
                item.update(status="update", detail="patched base image: " + ", ".join(stale)
                            + ("; rebuilding restarts " + ", ".join(shared) if len(shared) > 1 else ""), can_update=True,
                            action="rebuild-image" if r["image"] in LOCAL_BUILDS else "rebuild",
                            how=how_to("rebuild-image" if r["image"] in LOCAL_BUILDS else "rebuild", r))
            elif any(remote.get(b) is None for b in bl):
                item.update(status="unknown", detail="could not check its base image")
            else:
                item.update(status="current", detail="base image " + ", ".join(bl) + " is current")
            if newer_base:
                b, (nv, maj) = newer_base[0]
                df = os.path.join(LOCAL_BUILDS[r["image"]], "Dockerfile") if r["image"] in LOCAL_BUILDS else compose_dockerfile(r["workdir"], r["service"])
                item["newer"] = {"version": nv, "major": maj, "how": how_to("newer-base", dict(r, dockerfile=df), split_ref(b)[1].split("/")[-1] + ":" + nv, maj)}
                item["detail"] += "; base " + split_ref(b)[1].split("/")[-1] + " " + nv + " exists"
        else:
            pin = pinned_digest(r["image"])
            item["version"] = tag + (" · pinned" if pin else "")
            dig, loc = remote.get(r["image"]), ([pin] if pin else local_digests(r["image"]))
            if dig is None:
                item.update(status="unknown", detail="could not reach its registry")
            elif pin and dig != pin:
                # Pinned to an exact build on purpose, so a pull can't move it:
                # the compose file has to name the new build.
                item.update(status="update", detail="a patched build of " + tag + " is out; this service is pinned to an exact build, so the pin is changed by hand",
                            how=how_to("repin", r, dig))
            elif dig not in loc:
                item.update(status="update", detail="a patched build of " + tag + " is out", can_update=True,
                            action="pull", how=how_to("patched", r))
            else:
                item.update(status="current", detail=tag + " is the newest build of this version")
            nt = newer.get(r["image"])
            if isinstance(nt, tuple):
                nv, maj = nt
                item["newer"] = {"version": nv, "major": maj, "how": how_to("newer", r, nv, maj)}
                if item["status"] == "current":
                    item["status"] = "newer"
                    item["detail"] = ("new major version " if maj else "newer version ") + nv + " exists (manual)"
        out_rows.append(item)
    return {"checked": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "mailcow": {"current": mc_cur, "latest": mc_latest}, "services": out_rows}


def container_table():
    """Every container: the image name it was created from (.Config.Image keeps
    the name even after the tag has moved on to a newer image), the image it
    actually runs, and its compose labels."""
    ids = run(["docker", "ps", "-aq"], timeout=30)
    if ids is None:
        raise Refused("Docker did not answer")
    if not ids.split():
        return []
    fmt = ("{{.Name}}\t{{.Config.Image}}\t{{.Image}}\t{{index .Config.Labels \"com.docker.compose.project\"}}\t"
           "{{index .Config.Labels \"com.docker.compose.project.working_dir\"}}\t{{index .Config.Labels \"com.docker.compose.service\"}}")
    out = run(["docker", "inspect", "--format", fmt] + ids.split(), timeout=60) or ""
    rows = []
    for line in out.splitlines():
        p = line.split("\t")
        if len(p) == 6 and CONTAINER_RE.fullmatch(p[0].lstrip("/")):
            rows.append({"name": p[0].lstrip("/"), "image": p[1], "image_id": p[2], "project": p[3], "workdir": p[4], "service": p[5]})
    return rows


def image_id(ref):
    out = run(["docker", "image", "inspect", "--format", "{{.Id}}", ref])
    return out.strip() if out else None


def image_users(image):
    """(compose dir, service, container) of every container created from an
    image name, whether or not it runs the newest copy; only safe folders."""
    users = []
    for r in container_table():
        wd = compose_dir_ok(r["workdir"])
        if r["image"] == image and wd and SVC_NAME_RE.fullmatch(r["service"]) and (wd, r["service"], r["name"]) not in users:
            users.append((wd, r["service"], r["name"]))
    return users


def service_updates(args):
    """service-updates [refresh]: cached unless older than 6 h or asked to refresh."""
    if args not in ([], ["refresh"]):
        raise UnexpectedArgs()
    try:
        age = time.time() - os.stat(SVC_CACHE).st_mtime
        cached = json.load(open(SVC_CACHE))
    except (OSError, ValueError):
        age, cached = None, None
    if cached and not args and age is not None and age < SVC_MAX_AGE_S:
        return cached
    data = check_services()
    os.makedirs(os.path.dirname(SVC_CACHE), mode=0o700, exist_ok=True)
    fd, tmp = _tempfile.mkstemp(dir=os.path.dirname(SVC_CACHE), prefix=".svc-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o600)
    os.rename(tmp, SVC_CACHE)
    return data


def service_update(args):
    """service-update <container>|mailcow: apply an update Argus can make (background job)."""
    target = one_arg(args)
    if target == "mailcow":
        NOTED.append(["service-update", "mailcow"])
        script = ("set -eE -o pipefail; trap 'echo FAILED at line $LINENO' ERR; "
                  "echo '1/3 Mail backup first (it can be restored if the update goes wrong)'; "
                  "systemctl start mailcow-backup.service || { echo 'The backup failed; nothing was updated.'; exit 1; }; "
                  "echo '2/3 mailcow update (mail is unavailable for a few minutes)'; "
                  "cd " + MAILCOW_DIR + "; "
                  # update.sh exits 2 after updating itself and asks to be run again.
                  "rc=0; ./update.sh --force || rc=$?; "
                  "if [ \"$rc\" = 2 ]; then echo 'mailcow updated its updater first; running it again'; ./update.sh --force; "
                  "elif [ \"$rc\" != 0 ]; then echo \"mailcow's updater stopped (code $rc)\"; exit \"$rc\"; fi; "
                  "echo '3/3 Checking every mail container is running'; sleep 20; "
                  "bad=$(docker ps -a --filter label=com.docker.compose.project=mailcowdockerized --format '{{.Names}} {{.State}}' | grep -v ' running$' || true); "
                  "if [ -n \"$bad\" ]; then echo \"Not running: $bad\"; exit 1; fi; "
                  "rm -f " + SVC_CACHE + "; echo 'mailcow updated.'")
        return start_job("svc-update", script, max_s=4 * 3600)
    if not CONTAINER_RE.fullmatch(target):
        raise UnexpectedArgs()
    try:
        cached = json.load(open(SVC_CACHE))
    except (OSError, ValueError):
        raise Refused("check for updates first")
    item = next((x for x in cached.get("services", []) if x["name"] == target), None)
    if not item or not item.get("can_update") or item.get("action") not in ("pull", "rebuild", "rebuild-image", "recreate"):
        raise Refused("Argus has no update to apply for " + target + "; see How to Update")
    row = next((r for r in container_table() if r["name"] == target), None)
    wd = compose_dir_ok(row and row["workdir"])
    svc = row and row["service"]
    if not row or not wd or not SVC_NAME_RE.fullmatch(svc or ""):
        raise Refused("that service can't be updated from here (its folder must be a root-owned folder under /opt)")
    NOTED.append(["service-update", target, item["action"]])
    q = _shlex.quote
    if item["action"] == "rebuild-image":
        img = row["image"]
        if img not in LOCAL_BUILDS:
            raise Refused("that image is not one Argus builds")
        users = image_users(img)
        keep = img.split(":")[0] + ":before-update"
        restarts = "".join("(cd " + q(w) + " && docker compose up -d --no-deps --force-recreate " + q(sv) + "); " for w, sv, _ in users)
        names = " ".join(q(n) for _, _, n in users)
        script = ("set -eE -o pipefail; trap 'echo FAILED at line $LINENO; echo \"To undo: docker tag " + keep + " " + img + ", then restart the same containers\"' ERR; "
                  "echo '1/3 Rebuilding " + img + " on the newest base image (the current build is kept as " + keep + ")'; "
                  "docker tag " + q(img) + " " + q(keep) + "; echo \"before: $(docker image inspect --format '{{.Id}}' " + q(img) + ")\"; "
                  "docker build --pull -t " + q(img) + " " + q(LOCAL_BUILDS[img]) + "; "
                  "echo \"after: $(docker image inspect --format '{{.Id}}' " + q(img) + ")\"; "
                  "echo '2/3 Restarting every container that uses it'; " + restarts +
                  "echo '3/3 Checking they are running'; sleep 8; bad=''; "
                  "for c in " + names + "; do [ \"$(docker inspect --format '{{.State.Running}}' \"$c\")\" = true ] || bad=\"$bad $c\"; done; "
                  "if [ -n \"$bad\" ]; then echo \"Not running:$bad\"; false; fi; "
                  "rm -f " + SVC_CACHE + "; echo 'Updated.'")
        return start_job("svc-update", script, max_s=4 * 3600)
    keep = "argus-rollback/" + target.lower() + ":before-update"
    if item["action"] == "recreate":
        step = ("echo '1/3 Nothing to download: the current image is already here (the running one is kept as " + keep + ")'; "
                "docker tag \"$(docker inspect --format '{{.Image}}' " + q(target) + ")\" " + q(keep) + "; ")
    elif item["action"] == "pull":
        step = ("echo '1/3 Getting the patched image (the current one is kept as " + keep + ")'; "
                "docker tag \"$(docker inspect --format '{{.Image}}' " + q(target) + ")\" " + q(keep) + "; "
                "docker compose pull " + q(svc) + "; ")
    else:
        step = ("echo '1/3 Rebuilding on the newest base image (the current one is kept as " + keep + ")'; "
                "docker tag \"$(docker inspect --format '{{.Image}}' " + q(target) + ")\" " + q(keep) + "; "
                "docker compose build --pull " + q(svc) + "; ")
    script = ("set -eE -o pipefail; trap 'echo FAILED at line $LINENO' ERR; cd " + q(wd) + "; "
              "echo \"before: $(docker inspect --format '{{.Image}}' " + q(target) + ")\"; " + step +
              "echo '2/3 Restarting " + svc + " on it'; docker compose up -d --no-deps --force-recreate " + q(svc) + "; "
              "echo \"after: $(docker inspect --format '{{.Image}}' " + q(target) + ")\"; "
              "echo '3/3 Checking it is running'; sleep 8; "
              "[ \"$(docker inspect --format '{{.State.Running}}' " + q(target) + ")\" = true ] || { echo 'It is not running; see the log above.'; false; }; "
              "rm -f " + SVC_CACHE + "; echo 'Updated.'")
    return start_job("svc-update", script, max_s=4 * 3600)

def status(args):
    if args:
        raise UnexpectedArgs()
    ex = ThreadPoolExecutor(max_workers=len(SECTIONS))
    futs = {k: ex.submit(safe, fn) for k, fn in SECTIONS.items()}
    wait(futs.values(), timeout=DEADLINE_S)
    out = {"generated": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
    for k, f in futs.items():
        out[k] = f.result() if f.done() else None
    ex.shutdown(wait=False, cancel_futures=True)
    return out


