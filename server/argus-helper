def log(session, action, args, result):
    os.makedirs(LOG_DIR, mode=0o700, exist_ok=True)
    ts = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(json.dumps({"time": ts, "session": session, "action": action,
                            "args": [a[:64] if i == 0 or not action.startswith(("note-file", "file-", "mail", "app-", "alias", "quarantine")) else a[:330] for i, a in enumerate(args[:8])], "result": result}) + "\n")


def main(argv):
    if os.geteuid() != 0:
        print("argus-helper must run through sudo", file=sys.stderr)
        return 2
    if len(argv) < 3 or argv[0] != "--session" or not SESSION_RE.fullmatch(argv[1]):
        print("usage: argus-helper --session <id> <action> [args]", file=sys.stderr)
        return 2
    session, action, args = argv[1], argv[2], argv[3:]
    if action not in ACTIONS:
        log(session, action[:40], [], "refused: unknown action")
        print("unknown action", file=sys.stderr)
        return 2
    try:
        out = ACTIONS[action](args)
    except UnexpectedArgs:
        log(session, action, [], "refused: unexpected args")
        print("unexpected arguments", file=sys.stderr)
        return 2
    except Refused as e:
        log(session, action, NOTED[0] if NOTED else args, "refused: " + str(e)[:200])
        print(str(e), file=sys.stderr)
        return 3
    except Exception as e:
        log(session, action, NOTED[0] if NOTED else args, "failed: " + type(e).__name__ + (": " + str(e)[:120] if isinstance(e, OSError) else ""))
        print("action failed", file=sys.stderr)
        return 1
    log(session, action, NOTED[0] if NOTED else args, "ok")
    json.dump(out, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()
    # Leave now rather than wait for any section still running past the deadline.
    os._exit(0)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
